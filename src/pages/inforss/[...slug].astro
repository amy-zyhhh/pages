---
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import Topbar from "../../components/Topbar.astro";
import settings from "../../data/settings.json";
import "../../styles/shared.css";
import { parseInfoRssIndex, type InfoRssPost } from "../../utils/infoRssPosts";

export function getStaticPaths() {
	const indexPath = join(process.cwd(), "data-generated", "inforss", "index.json");
	if (!existsSync(indexPath)) return [];
	const indexRaw = readFileSync(indexPath, "utf-8");
	const posts = parseInfoRssIndex(indexRaw);

	return posts.map((post) => {
		return {
			params: { slug: post.slug },
			props: { post },
		};
	});
}

const { post } = Astro.props as {
	post: InfoRssPost;
};
const basePath = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const htmlContent = post.contentHtml || "";
---

<html
	lang="zh-CN"
	data-default-theme={settings.theme.default}
	data-theme-storage-key={settings.theme.storageKey}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{post.title}</title>
	</head>
	<body>
		<main class="shell app-shell">
			<Topbar ariaLabel="InfoRSS notice navigation" backHref={`${basePath}inforss/`} brand="InfoRSS" variant="reader" />

			<article class="notice">
				<div class="notice-meta">
					<time datetime={post.date}>{post.date}</time>
					<span>{post.category}</span>
					{post.department && <span>{post.department}</span>}
				</div>
				<h1>{post.title}</h1>
				<div class="notice-actions">
					{post.sourceUrl && <a href={post.sourceUrl} target="_blank" rel="noopener noreferrer">查看原文</a>}
				</div>

				<div class="content html-content" set:html={htmlContent} />
				{post.attachments && post.attachments.length > 0 && (
					<section class="attachments" aria-label="附件">
						<h2>附件</h2>
						{post.attachments.map((attachment) => (
							<a href={attachment.url || attachment.path} target="_blank" rel="noopener noreferrer">
								<span>{attachment.name}</span>
								{attachment.size && <small>{attachment.size}</small>}
							</a>
						))}
					</section>
				)}
			</article>
		</main>

		<script>
			const root = document.documentElement;
			const storageKey = root.dataset.themeStorageKey || "navigation-theme";
			const defaultTheme = root.dataset.defaultTheme || "system";

			function systemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function resolveTheme(theme) {
				return theme === "system" ? systemTheme() : theme;
			}

			root.dataset.theme = resolveTheme(localStorage.getItem(storageKey) || defaultTheme);

			document.querySelectorAll('.content a[href^="http"]').forEach((link) => {
				link.setAttribute("target", "_blank");
				link.setAttribute("rel", "noopener noreferrer");
			});
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #fbfaf7;
		--panel: #fffefb;
		--text: #1d2928;
		--muted: #64706d;
		--line: #ddd7cc;
		--accent: #267f86;
		--accent-strong: #155e63;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Microsoft YaHei", "PingFang SC", sans-serif;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		--bg: #171c1d;
		--panel: #202629;
		--text: #edf1ef;
		--muted: #a9b3b0;
		--line: #354044;
		--accent: #6db5b8;
		--accent-strong: #9ed5d7;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
	}

	.shell {
		--shell-width: 820px;
	}

	.notice {
		border-radius: 8px;
		background: var(--panel);
		box-shadow: 0 6px 20px rgba(29, 41, 40, 0.035);
		padding: 30px 34px 40px;
	}

	.notice-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 10px;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.notice-meta span {
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--accent-strong);
		padding: 2px 8px;
	}

	h1 {
		margin: 0;
		font-size: 1.68rem;
		line-height: 1.25;
		letter-spacing: 0;
	}

	p,
	li {
		color: var(--text);
		line-height: 1.9;
	}

	p {
		margin: 12px 0 0;
	}

	.notice-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 16px;
	}

	.notice-actions a,
	.attachments a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--accent-strong);
		font-weight: 800;
		text-decoration: none;
		padding: 7px 11px;
	}

	.content {
		margin-top: 22px;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4) {
		margin: 22px 0 0;
		letter-spacing: 0;
		line-height: 1.35;
	}

	.content :global(table) {
		display: block;
		overflow-x: auto;
		width: 100%;
		margin: 16px 0 0;
		border-collapse: collapse;
	}

	.content :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 14px auto 0;
	}

	.content :global(font),
	.content :global(span),
	.content :global(div) {
		max-width: 100%;
	}

	.content :global(.source-link) {
		margin-top: 24px;
		border-top: 1px solid color-mix(in srgb, var(--line), transparent 30%);
		padding-top: 16px;
	}

	.content :global(th),
	.content :global(td) {
		border: 1px solid var(--line);
		padding: 8px 10px;
		text-align: left;
		vertical-align: top;
	}

	.content :global(a) {
		color: var(--accent-strong);
		font-weight: 700;
	}

	.attachments {
		display: grid;
		gap: 10px;
		margin-top: 28px;
		border-top: 1px solid color-mix(in srgb, var(--line), transparent 30%);
		padding-top: 18px;
	}

	.attachments h2 {
		margin: 0;
		font-size: 1rem;
	}

	.attachments a {
		justify-content: space-between;
		width: fit-content;
		max-width: 100%;
		border-radius: 8px;
	}

	.attachments small {
		color: var(--muted);
		font-size: 0.78rem;
	}

	@media (max-width: 720px) {
		.shell {
			width: min(100% - 24px, 820px);
			padding-top: 12px;
		}

		.notice {
			padding: 20px;
		}

		h1 {
			font-size: 1.45rem;
		}
	}
</style>
