---
import ArticlePreviewCard from "../components/ArticlePreviewCard.astro";
import MobilePanelScript from "../components/MobilePanelScript.astro";
import Topbar from "../components/Topbar.astro";
import LinkCard from "../components/LinkCard.astro";
import protectedLinksYaml from "../data/protected-links.yaml?raw";
import settings from "../data/settings.json";
import { parseBlogPosts } from "../utils/blogPosts";
import { parseYamlLinks, type Link } from "../utils/parseLinks";
import { blogPostSearchText, linkToSearchCard, type SearchCardItem } from "../utils/searchItems";
import "../styles/shared.css";

const basePath = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const links = parseYamlLinks(protectedLinksYaml);
const sortedLinks = [...links].sort((a, b) => (a.order ?? 9999) - (b.order ?? 9999) || a.name.localeCompare(b.name));
const categories = Array.from(new Set(sortedLinks.map((link) => link.category))).sort((a, b) => {
	if (a === "其他") return 1;
	if (b === "其他") return -1;
	return 0;
});
const groups = categories.map((category) => ({
	category,
	links: sortedLinks.filter((link) => link.category === category),
}));
const blogModules = import.meta.glob("../../blogs/**/*.md", {
	query: "?raw",
	import: "default",
	eager: true,
});
const blogPosts = parseBlogPosts(blogModules);
const explicitlyIncludedProtectedSearchItems: SearchCardItem[] = [];
// Search scope: protected links, blog posts, and the explicit list above.
// Future content types must be added here deliberately before this search box can see them.
// Display order is intentional: link-like cards first, then blog previews.
const protectedSearchLinkItems: SearchCardItem[] = [
	...sortedLinks.map(linkToSearchCard),
	...explicitlyIncludedProtectedSearchItems,
];
const protectedSearchBlogPosts = blogPosts;
const shortcuts = settings.shortcuts;
---

<html
	lang="zh-CN"
	class="locked"
	data-default-theme={settings.theme.default}
	data-theme-storage-key={settings.theme.storageKey}
	data-shortcut-search={shortcuts.focusSearch}
	data-shortcut-clear={shortcuts.clearSearch}
	data-shortcut-theme={shortcuts.toggleTheme}
	data-unlocked-storage-key={settings.protectedAccess.storageKey}
	data-home-url={basePath}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>我的导航</title>
	</head>
	<body>
		<main class="shell app-shell">
			<Topbar ariaLabel="导航工具" backHref={basePath} backText="返回" title="我的导航" variant="home">
				<div class="actions" slot="actions">
					<button class="mobile-search-toggle app-icon-button" id="mobileSearchToggle" type="button" aria-controls="searchForm" aria-expanded="false" aria-label="展开搜索">
						⌕
					</button>
					<label class="theme-control">
						<span>主题</span>
						<button class="theme-button app-icon-button" id="themeButton" type="button" aria-label="切换深浅色">
							<span class="theme-track" aria-hidden="true">
								<span class="theme-thumb"></span>
							</span>
						</button>
					</label>
				</div>
				<form class="search topbar-search app-topbar-panel app-topbar-panel-full" id="searchForm" role="search" slot="panel">
					<label class="sr-only" for="searchInput">搜索</label>
					<input id="searchInput" type="search" placeholder="搜索导航、blogs" autocomplete="off" />
				</form>
			</Topbar>

			<div class="sections">
				<section class="link-section search-results" data-search-section hidden>
					<h2>搜索结果</h2>
					<div class="search-group" data-search-group>
						<div class="grid">
							{protectedSearchLinkItems.map((item) => <LinkCard {...item} />)}
						</div>
					</div>
					<div class="search-group blog-result-group" data-search-group>
						{protectedSearchBlogPosts.map((post) => (
							<ArticlePreviewCard
								href={`${basePath}blogs/${post.slug}/`}
								title={post.title}
								summary={post.summary}
								meta={[{ text: post.date }, { text: post.category }]}
								searchText={blogPostSearchText(post)}
								headingLevel={3}
							/>
						))}
					</div>
				</section>

				{
					groups.map((group) => (
						<section class="link-section" data-section data-category={group.category}>
							<h2>{group.category}</h2>
							<div class="grid">
								{group.links.map((link: Link) => <LinkCard {...link} />)}
							</div>
						</section>
					))
				}
			</div>

			<p class="empty" id="emptyState" hidden>没有找到匹配的入口。</p>
			{sortedLinks.length === 0 && <p class="empty">暂无加密入口。</p>}
		</main>
		<MobilePanelScript />

		<script>
			const root = document.documentElement;
			const storageKey = root.dataset.themeStorageKey || "navigation-theme";
			const defaultTheme = root.dataset.defaultTheme || "system";
			const unlockedStorageKey = root.dataset.unlockedStorageKey || "navigation-protected-unlocked";
			const homeUrl = root.dataset.homeUrl || "/";

			if (sessionStorage.getItem(unlockedStorageKey) !== "true") {
				window.location.replace(homeUrl);
			} else {
				root.classList.remove("locked");
			}

			const searchForm = document.querySelector("#searchForm");
			const searchInput = document.querySelector("#searchInput");
			const cards = Array.from(document.querySelectorAll("[data-card]"));
			const searchSection = document.querySelector("[data-search-section]");
			const searchGroups = Array.from(document.querySelectorAll("[data-search-group]"));
			const normalSections = Array.from(document.querySelectorAll("[data-section]"));
			const emptyState = document.querySelector("#emptyState");
			const themeButton = document.querySelector("#themeButton");
			const mobileSearchToggle = document.querySelector("#mobileSearchToggle");
			if (!searchForm || !searchInput || !searchSection || !emptyState || !themeButton || !mobileSearchToggle) {
				throw new Error("Protected navigation controls are incomplete.");
			}
			const searchCards = Array.from(searchSection.querySelectorAll("[data-card]"));
			const shortcuts = {
				focusSearch: root.dataset.shortcutSearch || "/",
				clearSearch: root.dataset.shortcutClear || "Escape",
				toggleTheme: root.dataset.shortcutTheme || "t",
			};

			function systemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function resolveTheme(theme) {
				return theme === "system" ? systemTheme() : theme;
			}

			function setTheme(theme) {
				root.dataset.theme = resolveTheme(theme);
				root.dataset.themeChoice = theme;
				localStorage.setItem(storageKey, theme);
			}

			function toggleTheme() {
				const current = root.dataset.themeChoice || defaultTheme;
				setTheme(resolveTheme(current) === "dark" ? "light" : "dark");
			}

			function updateCards() {
				const keyword = searchInput.value.trim().toLowerCase();
				let visibleCount = 0;
				const isSearching = keyword.length > 0;

				normalSections.forEach((section) => {
					section.hidden = isSearching;
				});
				searchSection.hidden = !isSearching;

				searchCards.forEach((card) => {
					const searchText = card.dataset.search;
					const isVisible = isSearching && searchText.includes(keyword);

					card.hidden = !isVisible;
					if (isVisible) visibleCount += 1;
				});

				searchGroups.forEach((group) => {
					group.hidden = !Array.from(group.querySelectorAll("[data-card]")).some((card) => !card.hidden);
				});

				cards.forEach((card) => {
					if (!searchSection.contains(card)) card.hidden = false;
				});

				emptyState.hidden = !isSearching || visibleCount > 0;
			}

			setTheme(localStorage.getItem(storageKey) || defaultTheme);
			searchInput.addEventListener("input", updateCards);
			searchForm.addEventListener("submit", (event) => {
				event.preventDefault();
			});
			themeButton.addEventListener("click", toggleTheme);
			window.initMobilePanelToggle?.({
				button: mobileSearchToggle,
				root,
				datasetKey: "mobileSearchOpen",
				focusTarget: searchInput,
			});
			window.addEventListener("keydown", (event) => {
				const key = event.key;
				const isTyping = ["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName || "");

				if (key === shortcuts.focusSearch && !isTyping) {
					event.preventDefault();
					searchInput.focus();
					return;
				}

				if (key === shortcuts.clearSearch && document.activeElement === searchInput) {
					searchInput.value = "";
					updateCards();
					searchInput.blur();
					return;
				}

				if (key.toLowerCase() === shortcuts.toggleTheme.toLowerCase() && !isTyping) {
					toggleTheme();
				}
			});
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #f8f7f3;
		--bg-grid: rgba(43, 54, 52, 0.045);
		--bg-grid-soft: rgba(43, 54, 52, 0.024);
		--panel: #fffdf8;
		--card: #ffffff;
		--text: #1d2928;
		--muted: #64706d;
		--line: #ddd7cc;
		--accent: #267f86;
		--accent-strong: #155e63;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Microsoft YaHei", "PingFang SC", sans-serif;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		--bg: #171c1d;
		--bg-grid: rgba(236, 242, 238, 0.05);
		--bg-grid-soft: rgba(236, 242, 238, 0.026);
		--panel: #202629;
		--card: #22282b;
		--text: #edf1ef;
		--muted: #a9b3b0;
		--line: #354044;
		--accent: #6db5b8;
		--accent-strong: #9ed5d7;
	}

	.locked body {
		visibility: hidden;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			linear-gradient(135deg, rgba(38, 127, 134, 0.1) 0%, transparent 34%),
			linear-gradient(315deg, rgba(185, 96, 59, 0.08) 0%, transparent 38%),
			linear-gradient(var(--bg-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px),
			linear-gradient(var(--bg-grid-soft) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid-soft) 1px, transparent 1px),
			var(--bg);
		background-position:
			center top,
			center bottom,
			center top,
			center top,
			center top,
			center top,
			center;
		background-size:
			auto,
			auto,
			32px 32px,
			32px 32px,
			8px 8px,
			8px 8px,
			auto;
		color: var(--text);
	}

	button,
	input {
		font: inherit;
	}

	.shell {
		--shell-width: 1180px;
	}

	.sections {
		display: grid;
		gap: 22px;
	}

	.link-section {
		display: grid;
		gap: 10px;
	}

	.link-section[hidden] {
		display: none;
	}

	.search-group[hidden] {
		display: none;
	}

	.blog-result-group {
		display: grid;
		gap: 10px;
	}

	.link-section h2 {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.link-section h2::after {
		height: 1px;
		flex: 1;
		background: var(--line);
		content: "";
		opacity: 0.65;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
		gap: 10px;
	}

	.empty {
		margin: 36px 0 0;
		color: var(--muted);
		text-align: center;
	}

	@media (max-width: 720px) {
		.actions {
			align-items: center;
			flex-direction: row;
			justify-content: end;
		}

		.sections {
			gap: 18px;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 9px;
		}

		body {
			background:
				linear-gradient(135deg, rgba(38, 127, 134, 0.055) 0%, transparent 34%),
				linear-gradient(315deg, rgba(185, 96, 59, 0.045) 0%, transparent 38%),
				var(--bg);
		}
	}

	@media (max-width: 359px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
