---
import LinkCard from "../components/LinkCard.astro";
import MobilePanelScript from "../components/MobilePanelScript.astro";
import ProtectedCard from "../components/ProtectedCard.astro";
import Topbar from "../components/Topbar.astro";
import linksYaml from "../data/links.yaml?raw";
import settings from "../data/settings.json";
import "../styles/shared.css";
import { parseYamlLinks, type Link } from "../utils/parseLinks";
import { linkToSearchCard, type SearchCardItem } from "../utils/searchItems";

const basePath = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const links = parseYamlLinks(linksYaml);
const sortedLinks = [...links].sort((a, b) => (a.order ?? 9999) - (b.order ?? 9999) || a.name.localeCompare(b.name));
const pinnedLinks = sortedLinks.filter((link) => link.pinned);
const categories = Array.from(new Set(sortedLinks.map((link) => link.category)));
if (!categories.includes("其他")) categories.push("其他");
const groups = categories.map((category) => ({
  category,
  links: sortedLinks.filter((link) => link.category === category),
}));
// Search scope: home page links only. Web search is handled separately by the / prefix.
// Future content types must be added here explicitly before this search box can see them.
const homeSearchItems: SearchCardItem[] = sortedLinks.map(linkToSearchCard);
const shortcuts = settings.shortcuts;
---

<html
	lang="zh-CN"
	data-default-theme={settings.theme.default}
	data-theme-storage-key={settings.theme.storageKey}
	data-shortcut-search={shortcuts.focusSearch}
	data-shortcut-clear={shortcuts.clearSearch}
	data-web-search-prefix={settings.webSearch.prefix}
	data-web-search-url={settings.webSearch.url}
	data-web-search-target={settings.webSearch.target}
	data-protected-url={`${basePath}protected/`}
	data-protected-password-hash={settings.protectedAccess.passwordHash}
	data-protected-max-attempts={settings.protectedAccess.maxAttempts}
	data-protected-lock-minutes={settings.protectedAccess.lockMinutes}
	data-protected-storage-key={settings.protectedAccess.storageKey}
	data-protected-attempts-key={settings.protectedAccess.attemptsKey}
	data-protected-lock-until-key={settings.protectedAccess.lockUntilKey}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>我的导航</title>
	</head>
	<body>
		<main class="shell app-shell">
			<Topbar ariaLabel="导航工具" title="我的导航" variant="home">
				<div class="actions" slot="actions">
					<button class="mobile-search-toggle app-icon-button" id="mobileSearchToggle" type="button" aria-controls="searchForm" aria-expanded="false" aria-label="展开搜索">
						⌕
					</button>
				</div>
				<form class="search topbar-search app-topbar-panel app-topbar-panel-full" id="searchForm" role="search" slot="panel">
					<label for="searchInput">搜索</label>
					<input id="searchInput" type="search" placeholder="搜索导航，输入 /关键词 后回车搜索 Bing" autocomplete="off" />
					<button class="app-button search-submit" type="submit">搜索</button>
				</form>
			</Topbar>

			<div class="sections">
				<section class="link-section search-results" data-search-section hidden>
					<h2>搜索结果</h2>
					<div class="grid">
						{homeSearchItems.map((link) => <LinkCard {...link} />)}
					</div>
				</section>

				{
					pinnedLinks.length > 0 && (
						<section class="link-section" data-section data-section-kind="pinned">
							<h2>置顶</h2>
							<div class="grid">
								{pinnedLinks.map((link: Link) => <LinkCard {...link} />)}
							</div>
						</section>
					)
				}

				{
					groups.map((group) => (
						<section class="link-section" data-section data-section-kind="category" data-category={group.category}>
							<h2>{group.category}</h2>
							<div class="grid">
								{group.links.map((link: Link) => <LinkCard {...link} />)}
								{group.category === "其他" && <ProtectedCard url={`${basePath}protected/`} />}
							</div>
						</section>
					))
				}
			</div>

			<p class="empty" id="emptyState" hidden>没有找到匹配的入口。</p>
		</main>
		<MobilePanelScript />

		<script>
			const root = document.documentElement;
			const searchForm = document.querySelector("#searchForm");
			const searchInput = document.querySelector("#searchInput");
			const cards = Array.from(document.querySelectorAll("[data-card]"));
			const searchSection = document.querySelector("[data-search-section]");
			const normalSections = Array.from(document.querySelectorAll("[data-section]"));
			const emptyState = document.querySelector("#emptyState");
			const mobileSearchToggle = document.querySelector("#mobileSearchToggle");
			const protectedButton = document.querySelector("#protectedButton");
			if (!searchForm || !searchInput || !searchSection || !emptyState || !mobileSearchToggle || !protectedButton) {
				throw new Error("Navigation page controls are incomplete.");
			}
			const searchCards = Array.from(searchSection.querySelectorAll("[data-card]"));
			const storageKey = root.dataset.themeStorageKey || "navigation-theme";
			const defaultTheme = root.dataset.defaultTheme || "system";
			const webSearch = {
				prefix: root.dataset.webSearchPrefix || "/",
				url: root.dataset.webSearchUrl || "https://www.bing.com/search?q={query}",
				target: root.dataset.webSearchTarget || "_blank",
			};
			const shortcuts = {
				focusSearch: root.dataset.shortcutSearch || "/",
				clearSearch: root.dataset.shortcutClear || "Escape",
			};
			const protectedAccess = {
				url: root.dataset.protectedUrl || "/protected/",
				passwordHash: root.dataset.protectedPasswordHash || "",
				maxAttempts: Number(root.dataset.protectedMaxAttempts || "3"),
				lockMinutes: Number(root.dataset.protectedLockMinutes || "5"),
				storageKey: root.dataset.protectedStorageKey || "navigation-protected-unlocked",
				attemptsKey: root.dataset.protectedAttemptsKey || "navigation-protected-attempts",
				lockUntilKey: root.dataset.protectedLockUntilKey || "navigation-protected-lock-until",
			};

			function systemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function resolveTheme(theme) {
				return theme === "system" ? systemTheme() : theme;
			}

			function setTheme(theme) {
				root.dataset.theme = resolveTheme(theme);
				root.dataset.themeChoice = theme;
				localStorage.setItem(storageKey, theme);
			}

			function getWebSearchQuery(value) {
				const trimmed = value.trim();
				if (!trimmed.startsWith(webSearch.prefix)) return "";
				return trimmed.slice(webSearch.prefix.length).trim();
			}

			function getLocalSearchKeyword(value) {
				const trimmed = value.trim();
				const keyword = trimmed.startsWith(webSearch.prefix)
					? trimmed.slice(webSearch.prefix.length).trim()
					: trimmed;
				return keyword.toLowerCase();
			}

			function openWebSearch(query) {
				const searchUrl = webSearch.url.replace("{query}", encodeURIComponent(query));
				window.open(searchUrl, webSearch.target, "noopener,noreferrer");
			}

			async function sha256Hex(value) {
				const bytes = new TextEncoder().encode(value);
				const hash = await crypto.subtle.digest("SHA-256", bytes);
				return Array.from(new Uint8Array(hash))
					.map((byte) => byte.toString(16).padStart(2, "0"))
					.join("");
			}

			function remainingLockSeconds() {
				const lockUntil = Number(localStorage.getItem(protectedAccess.lockUntilKey) || "0");
				return Math.max(0, Math.ceil((lockUntil - Date.now()) / 1000));
			}

			function resetProtectedAttempts() {
				localStorage.removeItem(protectedAccess.attemptsKey);
				localStorage.removeItem(protectedAccess.lockUntilKey);
			}

			async function openProtectedPage(event) {
				event.preventDefault();
				const lockSeconds = remainingLockSeconds();
				if (lockSeconds > 0) {
					alert(`错误次数过多，请 ${Math.ceil(lockSeconds / 60)} 分钟后再试。`);
					return;
				}

				const password = prompt("口令：");
				if (password === null) return;

				const passwordHash = await sha256Hex(password);
				if (passwordHash === protectedAccess.passwordHash) {
					resetProtectedAttempts();
					sessionStorage.setItem(protectedAccess.storageKey, "true");
					window.location.href = protectedAccess.url;
					return;
				}

				const attempts = Number(localStorage.getItem(protectedAccess.attemptsKey) || "0") + 1;
				if (attempts >= protectedAccess.maxAttempts) {
					localStorage.setItem(protectedAccess.lockUntilKey, String(Date.now() + protectedAccess.lockMinutes * 60 * 1000));
					localStorage.removeItem(protectedAccess.attemptsKey);
					alert(`密码错误次数过多，已锁定 ${protectedAccess.lockMinutes} 分钟。`);
					return;
				}

				localStorage.setItem(protectedAccess.attemptsKey, String(attempts));
				alert(`密码错误，还可以尝试 ${protectedAccess.maxAttempts - attempts} 次。`);
			}

			function updateCards() {
				const keyword = getLocalSearchKeyword(searchInput.value);
				let visibleCount = 0;
				const isSearching = keyword.length > 0;

				normalSections.forEach((section) => {
					section.hidden = isSearching;
				});
				searchSection.hidden = !isSearching;

				searchCards.forEach((card) => {
					const searchText = card.dataset.search;
					const isVisible = isSearching && searchText.includes(keyword);

					card.hidden = !isVisible;
					if (isVisible) visibleCount += 1;
				});

				cards.forEach((card) => {
					if (!searchSection.contains(card)) card.hidden = false;
				});

				emptyState.hidden = !isSearching || visibleCount > 0;
			}

			setTheme(localStorage.getItem(storageKey) || defaultTheme);
			searchInput.addEventListener("input", updateCards);
			searchForm.addEventListener("submit", (event) => {
				event.preventDefault();
				updateCards();
				const query = getWebSearchQuery(searchInput.value);
				if (!query) return;

				openWebSearch(query);
			});
			window.initMobilePanelToggle?.({
				button: mobileSearchToggle,
				root,
				datasetKey: "mobileSearchOpen",
				focusTarget: searchInput,
			});
			protectedButton.addEventListener("click", openProtectedPage);
			window.addEventListener("keydown", (event) => {
				const key = event.key;
				const isTyping = ["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName || "");

				if (key === shortcuts.focusSearch && !isTyping) {
					event.preventDefault();
					root.dataset.mobileSearchOpen = "true";
					mobileSearchToggle.setAttribute("aria-expanded", "true");
					searchInput.focus();
					return;
				}

				if (key === shortcuts.clearSearch && document.activeElement === searchInput) {
					searchInput.value = "";
					updateCards();
					searchInput.blur();
					return;
				}
			});
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #f8f7f3;
		--bg-grid: rgba(43, 54, 52, 0.045);
		--bg-grid-soft: rgba(43, 54, 52, 0.024);
		--panel: #fffdf8;
		--card: #ffffff;
		--text: #1d2928;
		--muted: #64706d;
		--line: #ddd7cc;
		--accent: #267f86;
		--accent-strong: #155e63;
		--warm: #b9603b;
		--shadow: 0 18px 48px rgba(34, 41, 43, 0.12);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Microsoft YaHei", "PingFang SC", sans-serif;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		--bg: #171c1d;
		--bg-grid: rgba(236, 242, 238, 0.05);
		--bg-grid-soft: rgba(236, 242, 238, 0.026);
		--panel: #202629;
		--card: #22282b;
		--text: #edf1ef;
		--muted: #a9b3b0;
		--line: #354044;
		--accent: #6db5b8;
		--accent-strong: #9ed5d7;
		--warm: #e0a071;
		--shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			linear-gradient(135deg, rgba(38, 127, 134, 0.1) 0%, transparent 34%),
			linear-gradient(315deg, rgba(185, 96, 59, 0.08) 0%, transparent 38%),
			linear-gradient(var(--bg-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px),
			linear-gradient(var(--bg-grid-soft) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid-soft) 1px, transparent 1px),
			var(--bg);
		background-size:
			auto,
			auto,
			32px 32px,
			32px 32px,
			8px 8px,
			8px 8px,
			auto;
		background-position:
			center top,
			center bottom,
			center top,
			center top,
			center top,
			center top,
			center;
		color: var(--text);
	}

	button,
	input {
		font: inherit;
	}

	.shell {
		--shell-width: 1180px;
	}

	.sections {
		display: grid;
		gap: 22px;
	}

	.link-section {
		display: grid;
		gap: 10px;
	}

	.link-section[hidden] {
		display: none;
	}

	.link-section h2 {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.link-section h2::after {
		height: 1px;
		flex: 1;
		background: var(--line);
		content: "";
		opacity: 0.65;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
		gap: 10px;
	}

	.empty {
		margin: 36px 0 0;
		color: var(--muted);
		text-align: center;
	}

	@media (max-width: 720px) {
		.sections {
			gap: 15px;
		}

		.link-section {
			gap: 8px;
		}

		.link-section h2 {
			font-size: 0.72rem;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 8px;
		}

		body {
			background:
				linear-gradient(135deg, rgba(38, 127, 134, 0.055) 0%, transparent 34%),
				linear-gradient(315deg, rgba(185, 96, 59, 0.045) 0%, transparent 38%),
				var(--bg);
		}
	}

	@media (max-width: 359px) {
		.actions {
			justify-content: start;
		}

		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
