---
import { ClientRouter } from "astro:transitions";
import settings from "../../../data/settings.json";
import { parseBlogPosts, type BlogPost } from "../../../utils/blogPosts";

export function getStaticPaths() {
	const modules = import.meta.glob("../../../../blogs/**/*.md", {
		query: "?raw",
		import: "default",
		eager: true,
	});
	const posts = parseBlogPosts(modules);
	const categories = Array.from(new Set(posts.map((post) => post.category)));

	return categories.map((category) => ({
		params: { category },
		props: {
			category,
			posts: posts.filter((post) => post.category === category),
		},
	}));
}

const { category, posts } = Astro.props as { category: string; posts: BlogPost[] };
const basePath = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<html
	lang="zh-CN"
	class="locked"
	data-default-theme={settings.theme.default}
	data-theme-storage-key={settings.theme.storageKey}
	data-unlocked-storage-key={settings.protectedAccess.storageKey}
	data-home-url={basePath}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>我的导航</title>
		<ClientRouter />
	</head>
	<body>
		<main class="shell">
			<nav class="topbar" aria-label="博客导航">
				<a href={`${basePath}blogs/`}>返回</a>
				<span>{category}</span>
			</nav>

			<section class="blog-list" aria-label={`${category} 分类文章`}>
				{posts.map((post) => (
					<article class="post" id={post.slug} transition:name={`blog-post-${post.slug}`}>
						<a class="post-link" href={`${basePath}blogs/${post.slug}/`}>
							<div class="post-meta">
								<time datetime={post.date}>{post.date}</time>
							</div>
							<h1>{post.title}</h1>
							{post.summary && <p class="summary">{post.summary}</p>}
						</a>
					</article>
				))}
			</section>
		</main>

		<script data-astro-rerun>
			function systemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function resolveTheme(theme) {
				return theme === "system" ? systemTheme() : theme;
			}

			function initCurrentBlogPage() {
				const root = document.documentElement;
				const storageKey = root.dataset.themeStorageKey || "navigation-theme";
				const defaultTheme = root.dataset.defaultTheme || "system";
				const unlockedStorageKey = root.dataset.unlockedStorageKey || "navigation-protected-unlocked";
				const homeUrl = root.dataset.homeUrl || "/";

				if (sessionStorage.getItem(unlockedStorageKey) !== "true") {
					window.location.replace(homeUrl);
					return;
				}

				root.classList.remove("locked");
				root.dataset.theme = resolveTheme(localStorage.getItem(storageKey) || defaultTheme);

				if (window.__blogDetailScrollHandler) {
					window.removeEventListener("scroll", window.__blogDetailScrollHandler);
					window.__blogDetailScrollHandler = null;
				}
				root.dataset.scrolled = String(window.scrollY > 96);
			}

			window.__initCurrentBlogPage = initCurrentBlogPage;
			if (!window.__blogPageAfterSwapBound) {
				document.addEventListener("astro:after-swap", () => window.__initCurrentBlogPage?.());
				window.__blogPageAfterSwapBound = true;
			}
			initCurrentBlogPage();
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #f8f7f3;
		--bg-grid: rgba(43, 54, 52, 0.045);
		--bg-grid-soft: rgba(43, 54, 52, 0.024);
		--panel: #fffdf8;
		--card: #ffffff;
		--text: #1d2928;
		--muted: #64706d;
		--line: #ddd7cc;
		--accent: #267f86;
		--accent-strong: #155e63;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Microsoft YaHei", "PingFang SC", sans-serif;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		--bg: #171c1d;
		--bg-grid: rgba(236, 242, 238, 0.05);
		--bg-grid-soft: rgba(236, 242, 238, 0.026);
		--panel: #202629;
		--card: #22282b;
		--text: #edf1ef;
		--muted: #a9b3b0;
		--line: #354044;
		--accent: #6db5b8;
		--accent-strong: #9ed5d7;
	}

	.locked body {
		visibility: hidden;
	}

	* {
		box-sizing: border-box;
	}

	@keyframes blog-page-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes blog-page-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	::view-transition-old(root) {
		animation: 120ms ease both blog-page-out;
	}

	::view-transition-new(root) {
		animation: 180ms ease both blog-page-in;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			linear-gradient(135deg, rgba(38, 127, 134, 0.1) 0%, transparent 34%),
			linear-gradient(315deg, rgba(185, 96, 59, 0.08) 0%, transparent 38%),
			linear-gradient(var(--bg-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px),
			linear-gradient(var(--bg-grid-soft) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid-soft) 1px, transparent 1px),
			var(--bg);
		background-size:
			auto,
			auto,
			32px 32px,
			32px 32px,
			8px 8px,
			8px 8px,
			auto;
		color: var(--text);
	}

	.shell {
		width: min(720px, calc(100% - 32px));
		margin: 0 auto;
		padding: 24px 0 48px;
	}

	.topbar {
		position: sticky;
		top: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 18px;
		padding: 10px;
		border: 1px solid color-mix(in srgb, var(--line), transparent 35%);
		border-radius: 8px;
		background: color-mix(in srgb, var(--panel), transparent 1%);
		box-shadow: 0 4px 14px rgba(29, 41, 40, 0.03);
		backdrop-filter: blur(12px);
	}

	.topbar a {
		color: var(--accent-strong);
		font-weight: 800;
		text-decoration: none;
	}

	.topbar span {
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 800;
	}

	.blog-list {
		display: grid;
		gap: 12px;
	}

	.post {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--card);
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.post:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.post-link {
		display: block;
		color: inherit;
		padding: 18px;
		text-decoration: none;
	}

	.post-meta {
		margin-bottom: 8px;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
	}

	h1 {
		margin: 0;
		font-size: 1.24rem;
		line-height: 1.3;
		letter-spacing: 0;
	}

	p {
		margin: 10px 0 0;
		color: var(--text);
		line-height: 1.7;
	}

	.summary {
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.shell {
			width: min(100% - 24px, 720px);
			padding-top: 12px;
		}

		.post-link {
			padding: 15px;
		}
	}
</style>
