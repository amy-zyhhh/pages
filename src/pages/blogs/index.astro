---
import { ClientRouter } from "astro:transitions";
import ArticlePreviewCard from "../../components/ArticlePreviewCard.astro";
import MobilePanelScript from "../../components/MobilePanelScript.astro";
import Topbar from "../../components/Topbar.astro";
import settings from "../../data/settings.json";
import { parseBlogPosts } from "../../utils/blogPosts";
import { blogPostSearchText } from "../../utils/searchItems";
import "../../styles/shared.css";

const basePath = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const modules = import.meta.glob("../../../blogs/**/*.md", {
	query: "?raw",
	import: "default",
	eager: true,
});

const posts = parseBlogPosts(modules);
// Search scope: blog posts only.
// Future content types must be added here explicitly before this search box can see them.
const blogSearchPosts = posts;
const categories = Array.from(new Set(blogSearchPosts.map((post) => post.category)));
const dateGroups = Array.from(new Set(blogSearchPosts.map((post) => post.date))).map((date) => ({
	date,
	posts: blogSearchPosts.filter((post) => post.date === date),
}));
---

<html
	lang="zh-CN"
	class="locked"
	data-default-theme={settings.theme.default}
	data-theme-storage-key={settings.theme.storageKey}
	data-unlocked-storage-key={settings.protectedAccess.storageKey}
	data-home-url={basePath}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>我的导航</title>
		<ClientRouter />
	</head>
	<body>
		<main class="shell app-shell">
			<Topbar ariaLabel="博客导航" backHref={`${basePath}protected/`} brand="blogs">
				<button class="mobile-search-toggle icon-button" id="mobileSearchToggle" type="button" aria-controls="blogTools" aria-expanded="false" aria-label="展开搜索" slot="actions">
					⌕
				</button>
				<div class="blog-tools" id="blogTools" slot="panel">
					<form class="blog-search topbar-search" role="search">
						<label class="sr-only" for="blogSearchInput">搜索</label>
						<input id="blogSearchInput" type="search" placeholder="搜索 blogs" autocomplete="off" />
					</form>
					<div class="category-nav" aria-label="博客分类">
						{categories.map((category) => (
							<a href={`${basePath}blogs/category/${encodeURIComponent(category)}/`}>{category}</a>
						))}
					</div>
				</div>
			</Topbar>

			<section class="blog-list" aria-label="按日期排列的博客">
				{dateGroups.map((group) => (
					<div class="date-group">
						<div class="date-divider">
							<time datetime={group.date}>{group.date}</time>
						</div>
						{group.posts.map((post) => (
							<ArticlePreviewCard
								href={`${basePath}blogs/${post.slug}/`}
								title={post.title}
								summary={post.summary}
								meta={[{ text: post.category }]}
								searchText={blogPostSearchText(post)}
								transitionName={`blog-post-${post.slug}`}
								attributes={{ id: post.slug, "data-post": "" }}
							/>
						))}
					</div>
				))}
			</section>
			<p class="empty" id="emptyState" hidden>没有找到匹配的博客。</p>
		</main>
		<MobilePanelScript />

		<script data-astro-rerun>
			function systemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function resolveTheme(theme) {
				return theme === "system" ? systemTheme() : theme;
			}

			function initCurrentBlogPage() {
				const root = document.documentElement;
				const storageKey = root.dataset.themeStorageKey || "navigation-theme";
				const defaultTheme = root.dataset.defaultTheme || "system";
				const unlockedStorageKey = root.dataset.unlockedStorageKey || "navigation-protected-unlocked";
				const homeUrl = root.dataset.homeUrl || "/";

				if (sessionStorage.getItem(unlockedStorageKey) !== "true") {
					window.location.replace(homeUrl);
					return;
				}

				root.classList.remove("locked");
				root.dataset.theme = resolveTheme(localStorage.getItem(storageKey) || defaultTheme);
				initBlogListPage();
				initBlogDetailPage(root);
			}

			function initBlogListPage() {
				const searchInput = document.querySelector("#blogSearchInput");
				const mobileSearchToggle = document.querySelector("#mobileSearchToggle");
				const posts = Array.from(document.querySelectorAll("[data-post]"));
				const dateGroups = Array.from(document.querySelectorAll(".date-group"));
				const emptyState = document.querySelector("#emptyState");
				if (!searchInput || !emptyState) return;

				function updatePosts() {
					const keyword = searchInput.value.trim().toLowerCase();
					let visibleCount = 0;

					posts.forEach((post) => {
						const isVisible = !keyword || (post.dataset.search || "").includes(keyword);
						post.hidden = !isVisible;
						if (isVisible) visibleCount += 1;
					});

					dateGroups.forEach((group) => {
						const hasVisiblePost = Array.from(group.querySelectorAll("[data-post]")).some((post) => !post.hidden);
						group.hidden = !hasVisiblePost;
					});

					emptyState.hidden = !keyword || visibleCount > 0;
				}

				searchInput.oninput = updatePosts;
				window.initMobilePanelToggle?.({
					button: mobileSearchToggle,
					root: document.documentElement,
					datasetKey: "mobileSearchOpen",
					focusTarget: searchInput,
				});
				updatePosts();
			}

			function initBlogDetailPage(root) {
				if (window.__blogDetailScrollHandler) {
					window.removeEventListener("scroll", window.__blogDetailScrollHandler);
					window.__blogDetailScrollHandler = null;
				}

				const sidebarToggle = document.querySelector("#sidebarToggle");
				const tocLinks = Array.from(document.querySelectorAll(".toc-link"));
				const headingIds = tocLinks
					.map((link) => link.getAttribute("href") || "")
					.filter((href) => href.startsWith("#"))
					.map((href) => href.slice(1));
				if (!sidebarToggle) {
					root.dataset.scrolled = String(window.scrollY > 96);
					return;
				}

				if (headingIds.length > 0) {
					document.querySelectorAll(".content h1, .content h2, .content h3, .content h4").forEach((heading, index) => {
						const id = headingIds[index];
						if (id) heading.id = id;
					});
				}

				const sidebarStorageKey = "navigation-blog-sidebar-hidden";
				function setSidebarHidden(isHidden) {
					root.dataset.sidebarHidden = String(isHidden);
					localStorage.setItem(sidebarStorageKey, String(isHidden));
					sidebarToggle.setAttribute("aria-pressed", String(isHidden));
				}

				const savedSidebarHidden = localStorage.getItem(sidebarStorageKey);
				delete root.dataset.sidebarReady;
				setSidebarHidden(savedSidebarHidden === null ? true : savedSidebarHidden === "true");
				requestAnimationFrame(() => {
					root.dataset.sidebarReady = "true";
				});
				sidebarToggle.onclick = () => {
					setSidebarHidden(root.dataset.sidebarHidden !== "true");
				};

				function setActiveHeading() {
					let activeId = headingIds[0];
					for (const id of headingIds) {
						const heading = document.getElementById(id);
						if (heading && heading.getBoundingClientRect().top <= 120) {
							activeId = id;
						}
					}

					tocLinks.forEach((link) => {
						link.classList.toggle("active", link.getAttribute("href") === `#${activeId}`);
					});
					root.dataset.scrolled = String(window.scrollY > 96);
				}

				window.__blogDetailScrollHandler = setActiveHeading;
				window.addEventListener("scroll", setActiveHeading, { passive: true });
				setActiveHeading();
			}

			window.__initCurrentBlogPage = initCurrentBlogPage;
			if (!window.__blogPageAfterSwapBound) {
				document.addEventListener("astro:after-swap", () => window.__initCurrentBlogPage?.());
				window.__blogPageAfterSwapBound = true;
			}
			initCurrentBlogPage();
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #f8f7f3;
		--bg-grid: rgba(43, 54, 52, 0.045);
		--bg-grid-soft: rgba(43, 54, 52, 0.024);
		--panel: #fffdf8;
		--card: #ffffff;
		--text: #1d2928;
		--muted: #64706d;
		--line: #ddd7cc;
		--accent: #267f86;
		--accent-strong: #155e63;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Microsoft YaHei", "PingFang SC", sans-serif;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		--bg: #171c1d;
		--bg-grid: rgba(236, 242, 238, 0.05);
		--bg-grid-soft: rgba(236, 242, 238, 0.026);
		--panel: #202629;
		--card: #22282b;
		--text: #edf1ef;
		--muted: #a9b3b0;
		--line: #354044;
		--accent: #6db5b8;
		--accent-strong: #9ed5d7;
	}

	.locked body {
		visibility: hidden;
	}

	* {
		box-sizing: border-box;
	}

	@keyframes blog-page-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes blog-page-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	::view-transition-old(root) {
		animation: 120ms ease both blog-page-out;
	}

	::view-transition-new(root) {
		animation: 180ms ease both blog-page-in;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			linear-gradient(135deg, rgba(38, 127, 134, 0.1) 0%, transparent 34%),
			linear-gradient(315deg, rgba(185, 96, 59, 0.08) 0%, transparent 38%),
			linear-gradient(var(--bg-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px),
			linear-gradient(var(--bg-grid-soft) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid-soft) 1px, transparent 1px),
			var(--bg);
		background-size:
			auto,
			auto,
			32px 32px,
			32px 32px,
			8px 8px,
			8px 8px,
			auto;
		color: var(--text);
	}

	.shell {
		--shell-width: 720px;
	}

	.mobile-search-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 34px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		color: var(--accent-strong);
		cursor: pointer;
		padding: 0;
		font: inherit;
		font-size: 1.12rem;
		font-weight: 800;
		line-height: 1;
	}

	.blog-tools {
		display: flex;
		align-items: center;
		gap: 12px;
		grid-column: 2;
		grid-row: 1;
		min-width: 0;
	}

	.blog-search {
		display: grid;
		gap: 6px;
		width: min(240px, 100%);
	}

	.blog-search label {
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.blog-search input {
		width: 100%;
		height: 34px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--card);
		color: var(--text);
		padding: 8px 10px;
		outline: none;
	}

	.blog-search input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 4px rgba(38, 127, 134, 0.14);
	}

	.blog-list {
		display: grid;
		gap: 20px;
	}

	.date-group {
		display: grid;
		gap: 12px;
	}

	.date-group[hidden] {
		display: none;
	}

	.date-divider {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0;
	}

	.date-divider::after {
		height: 1px;
		flex: 1;
		background: var(--line);
		content: "";
		opacity: 0.65;
	}

	.category-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		flex: 1;
		min-width: 0;
	}

	.category-nav a {
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		color: var(--accent-strong);
		padding: 6px 12px;
		font-size: 0.9rem;
		font-weight: 800;
		text-decoration: none;
	}

	@media (max-width: 560px) {
		.mobile-search-toggle {
			display: flex;
		}

		.blog-tools {
			display: none;
			grid-column: 1 / -1;
			grid-row: auto;
			order: 2;
		}

		:root[data-mobile-search-open="true"] .blog-tools {
			display: grid;
			gap: 10px;
		}

		.category-nav {
			width: 100%;
		}

		.blog-search {
			width: 100%;
		}

		body {
			background:
				linear-gradient(135deg, rgba(38, 127, 134, 0.055) 0%, transparent 34%),
				linear-gradient(315deg, rgba(185, 96, 59, 0.045) 0%, transparent 38%),
				var(--bg);
		}
	}

	.post {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--card);
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.post[hidden] {
		display: none;
	}

	.post:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.post-link {
		display: block;
		color: inherit;
		padding: 18px;
		text-decoration: none;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 8px;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.post-meta span {
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 2px 8px;
		color: var(--accent-strong);
	}

	h1 {
		margin: 0;
		font-size: 1.24rem;
		line-height: 1.3;
		letter-spacing: 0;
	}

	p {
		margin: 10px 0 0;
		color: var(--text);
		line-height: 1.7;
	}

	.summary {
		color: var(--muted);
	}

	.empty {
		margin: 36px 0 0;
		color: var(--muted);
		text-align: center;
	}

	@media (max-width: 720px) {
		.post {
			padding: 0;
		}

		.post-link {
			padding: 15px;
		}
	}
</style>
