---
import { ClientRouter } from "astro:transitions";
import Topbar from "../../components/Topbar.astro";
import settings from "../../data/settings.json";
import { parseBlogHeadings, parseBlogPosts, type BlogPost } from "../../utils/blogPosts";
import "../../styles/shared.css";

type MarkdownModule = {
	Content: unknown;
};

export function getStaticPaths() {
	const modules = import.meta.glob("../../../blogs/**/*.md", {
		query: "?raw",
		import: "default",
		eager: true,
	});
	const markdownModules = import.meta.glob<MarkdownModule>("../../../blogs/**/*.md", {
		eager: true,
	});
	const posts = parseBlogPosts(modules);

	return posts.map((post) => {
		const markdownModule = markdownModules[post.sourcePath];
		if (!markdownModule) {
			throw new Error(`Missing Markdown module for ${post.sourcePath}`);
		}

		return {
			params: { slug: post.slug },
			props: { post, Content: markdownModule.Content },
		};
	});
}

const { post, Content } = Astro.props as { post: BlogPost; Content: AstroComponentFactory };
const headings = parseBlogHeadings(post.body);
const basePath = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const sidebarStorageKey = "navigation-blog-sidebar-hidden";
---

<html
	lang="zh-CN"
	class="locked"
	data-default-theme={settings.theme.default}
	data-theme-storage-key={settings.theme.storageKey}
	data-unlocked-storage-key={settings.protectedAccess.storageKey}
	data-home-url={basePath}
	data-sidebar-storage-key={sidebarStorageKey}
	data-heading-ids={JSON.stringify(headings.map((heading) => heading.id))}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>我的导航</title>
		<ClientRouter />
	</head>
	<body>
		<main class="shell app-shell">
			<div class="reader">
				<div class="article-column">
					<Topbar ariaLabel="Blog navigation" backHref={`${basePath}blogs/`} brand="blogs">
						<span class="topbar-post-title" slot="start">{post.title}</span>
						<button class="sidebar-toggle pill-button" id="sidebarToggle" type="button" aria-controls="blogSidebar" aria-pressed="false" slot="actions">
							目录
						</button>
					</Topbar>
					<button class="sidebar-scrim" id="sidebarScrim" type="button" aria-label="关闭目录"></button>

					<article class="post" id="top" transition:name={`blog-post-${post.slug}`}>
						<div class="post-meta">
							<time datetime={post.date}>{post.date}</time>
							<a href={`${basePath}blogs/category/${encodeURIComponent(post.category)}/`}>{post.category}</a>
						</div>
						<h1>{post.title}</h1>
						{post.summary && <p class="summary">{post.summary}</p>}

						<div class="content">
							<Content />
						</div>
					</article>
				</div>

				<aside class="sidebar" id="blogSidebar" aria-label="文章侧边栏">
					<div class="sidebar-panel">
						<div class="sidebar-meta">
							<time datetime={post.date}>{post.date}</time>
							<a href={`${basePath}blogs/category/${encodeURIComponent(post.category)}/`}>{post.category}</a>
						</div>
						{headings.length > 0 && (
							<nav class="toc" aria-label="文章目录">
								{headings.map((heading) => (
									<a class={`toc-link depth-${heading.depth}`} href={`#${heading.id}`}>{heading.text}</a>
								))}
							</nav>
						)}
					</div>
				</aside>
			</div>
		</main>

		<script data-astro-rerun>
			function systemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function resolveTheme(theme) {
				return theme === "system" ? systemTheme() : theme;
			}

			function initCurrentBlogPage() {
				const root = document.documentElement;
				const storageKey = root.dataset.themeStorageKey || "navigation-theme";
				const defaultTheme = root.dataset.defaultTheme || "system";
				const unlockedStorageKey = root.dataset.unlockedStorageKey || "navigation-protected-unlocked";
				const homeUrl = root.dataset.homeUrl || "/";

				if (sessionStorage.getItem(unlockedStorageKey) !== "true") {
					window.location.replace(homeUrl);
					return;
				}

				root.classList.remove("locked");
				root.dataset.theme = resolveTheme(localStorage.getItem(storageKey) || defaultTheme);
				initBlogListPage();
				initBlogDetailPage(root);
				enhanceCodeBlocks();
				initCodeCopyButtons();
			}

			function initBlogListPage() {
				const searchInput = document.querySelector("#blogSearchInput");
				const posts = Array.from(document.querySelectorAll("[data-post]"));
				const dateGroups = Array.from(document.querySelectorAll(".date-group"));
				const emptyState = document.querySelector("#emptyState");
				if (!searchInput || !emptyState) return;

				function updatePosts() {
					const keyword = searchInput.value.trim().toLowerCase();
					let visibleCount = 0;

					posts.forEach((post) => {
						const isVisible = !keyword || (post.dataset.search || "").includes(keyword);
						post.hidden = !isVisible;
						if (isVisible) visibleCount += 1;
					});

					dateGroups.forEach((group) => {
						const hasVisiblePost = Array.from(group.querySelectorAll("[data-post]")).some((post) => !post.hidden);
						group.hidden = !hasVisiblePost;
					});

					emptyState.hidden = !keyword || visibleCount > 0;
				}

				searchInput.oninput = updatePosts;
				updatePosts();
			}

			function initBlogDetailPage(root) {
				if (window.__blogDetailScrollHandler) {
					window.removeEventListener("scroll", window.__blogDetailScrollHandler);
					window.__blogDetailScrollHandler = null;
				}

				const sidebarStorageKey = "navigation-blog-sidebar-hidden";
				const sidebarToggle = document.querySelector("#sidebarToggle");
				const sidebarScrim = document.querySelector("#sidebarScrim");
				const tocLinks = Array.from(document.querySelectorAll(".toc-link"));
				const headingIds = tocLinks
					.map((link) => link.getAttribute("href") || "")
					.filter((href) => href.startsWith("#"))
					.map((href) => href.slice(1));
				if (!sidebarToggle) {
					root.dataset.scrolled = String(window.scrollY > 96);
					return;
				}

				if (headingIds.length > 0) {
					document.querySelectorAll(".content h1, .content h2, .content h3, .content h4").forEach((heading, index) => {
						const id = headingIds[index];
						if (id) heading.id = id;
					});
				}

				function setSidebarHidden(isHidden) {
					root.dataset.sidebarHidden = String(isHidden);
					localStorage.setItem(sidebarStorageKey, String(isHidden));
					sidebarToggle.setAttribute("aria-pressed", String(isHidden));
				}

				const savedSidebarHidden = localStorage.getItem(sidebarStorageKey);
				delete root.dataset.sidebarReady;
				setSidebarHidden(savedSidebarHidden === null ? true : savedSidebarHidden === "true");
				requestAnimationFrame(() => {
					root.dataset.sidebarReady = "true";
				});
				sidebarToggle.onclick = () => {
					setSidebarHidden(root.dataset.sidebarHidden !== "true");
				};
				sidebarScrim?.addEventListener("click", () => setSidebarHidden(true));
				tocLinks.forEach((link) => {
					link.addEventListener("click", () => {
						if (window.matchMedia("(max-width: 720px)").matches) {
							setSidebarHidden(true);
						}
					});
				});

				function setActiveHeading() {
					let activeId = headingIds[0];
					for (const id of headingIds) {
						const heading = document.getElementById(id);
						if (heading && heading.getBoundingClientRect().top <= 120) {
							activeId = id;
						}
					}

					tocLinks.forEach((link) => {
						link.classList.toggle("active", link.getAttribute("href") === `#${activeId}`);
					});
					root.dataset.scrolled = String(window.scrollY > 96);
				}

				window.__blogDetailScrollHandler = setActiveHeading;
				window.addEventListener("scroll", setActiveHeading, { passive: true });
				setActiveHeading();
			}

			function enhanceCodeBlocks() {
				document.querySelectorAll(".content pre").forEach((pre) => {
					if (pre.dataset.enhanced === "true") return;

					const code = pre.querySelector("code");
					if (!code) return;

					const rawCode = code.textContent || "";
					const wrapper = document.createElement("div");
					wrapper.className = "code-block";

					const copyButton = document.createElement("button");
					copyButton.className = "code-copy";
					copyButton.type = "button";
					copyButton.textContent = "复制";
					copyButton.setAttribute("aria-label", "复制代码");
					copyButton.addEventListener("click", async () => {
						try {
							await navigator.clipboard.writeText(rawCode);
							copyButton.textContent = "已复制";
						} catch {
							const textarea = document.createElement("textarea");
							textarea.value = rawCode;
							textarea.style.position = "fixed";
							textarea.style.opacity = "0";
							document.body.append(textarea);
							textarea.select();
							document.execCommand("copy");
							textarea.remove();
							copyButton.textContent = "已复制";
						}

						window.setTimeout(() => {
							copyButton.textContent = "复制";
						}, 1200);
					});

					const lines = rawCode.replace(/\n$/, "").split(/\r?\n/);
					code.textContent = "";
					lines.forEach((line) => {
						const lineElement = document.createElement("span");
						lineElement.className = "code-line";
						lineElement.textContent = line || " ";
						code.append(lineElement);
					});

					pre.dataset.enhanced = "true";
					pre.parentNode?.insertBefore(wrapper, pre);
					wrapper.append(copyButton, pre);
				});
			}

			function initCodeCopyButtons() {
				if (window.__blogCodeCopyPositionHandler) {
					window.removeEventListener("scroll", window.__blogCodeCopyPositionHandler);
					window.removeEventListener("resize", window.__blogCodeCopyPositionHandler);
					window.__blogCodeCopyPositionHandler = null;
				}

				const buttons = Array.from(document.querySelectorAll(".code-block > .code-copy"));
				if (buttons.length === 0) return;

				function resetButton(button) {
					button.style.position = "absolute";
					button.style.top = "10px";
					button.style.right = "10px";
					button.style.left = "auto";
				}

				function positionButtons() {
					const topbar = document.querySelector(".app-topbar");
					const stickyTop = Math.max(58, (topbar?.getBoundingClientRect().height || 0) + 10);

					buttons.forEach((button) => {
						const block = button.closest(".code-block");
						if (!block) return;

						const blockRect = block.getBoundingClientRect();
						const buttonWidth = button.offsetWidth || 56;
						const buttonHeight = button.offsetHeight || 30;
						const shouldFix = blockRect.top < stickyTop && blockRect.bottom > stickyTop + buttonHeight + 12;

						if (!shouldFix) {
							resetButton(button);
							return;
						}

						button.style.position = "fixed";
						button.style.top = `${stickyTop}px`;
						button.style.left = `${Math.max(8, blockRect.right - buttonWidth - 10)}px`;
						button.style.right = "auto";
					});
				}

				window.__blogCodeCopyPositionHandler = positionButtons;
				window.addEventListener("scroll", positionButtons, { passive: true });
				window.addEventListener("resize", positionButtons);
				positionButtons();
			}

			window.__initCurrentBlogPage = initCurrentBlogPage;
			if (!window.__blogPageAfterSwapBound) {
				document.addEventListener("astro:after-swap", () => window.__initCurrentBlogPage?.());
				window.__blogPageAfterSwapBound = true;
			}
			initCurrentBlogPage();
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #fbfaf7;
		--panel: #fffefb;
		--card: #ffffff;
		--article: #fffefb;
		--text: #1d2928;
		--muted: #64706d;
		--line: #ddd7cc;
		--accent: #267f86;
		--accent-strong: #155e63;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Microsoft YaHei", "PingFang SC", sans-serif;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		--bg: #171c1d;
		--panel: #202629;
		--card: #22282b;
		--article: #202629;
		--text: #edf1ef;
		--muted: #a9b3b0;
		--line: #354044;
		--accent: #6db5b8;
		--accent-strong: #9ed5d7;
	}

	.locked body {
		visibility: hidden;
	}

	* {
		box-sizing: border-box;
	}

	@keyframes blog-page-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes blog-page-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	::view-transition-old(root) {
		animation: 120ms ease both blog-page-out;
	}

	::view-transition-new(root) {
		animation: 180ms ease both blog-page-in;
	}

	body {
		margin: 0;
		min-height: 100vh;
		overflow-x: hidden;
		background: var(--bg);
		color: var(--text);
	}

	.shell {
		--shell-width: 1080px;
	}

	.app-topbar-start::after {
		width: 1px;
		height: 20px;
		background: color-mix(in srgb, var(--line), transparent 12%);
		content: "";
		opacity: 0;
		transition: opacity 0.16s ease;
	}

	:root[data-scrolled="true"] .app-topbar-start::after {
		opacity: 1;
	}

	.app-topbar .topbar-post-title {
		overflow: hidden;
		color: var(--text);
		font-size: 1.05rem;
		font-weight: 800;
		line-height: 1.25;
		opacity: 0;
		text-overflow: ellipsis;
		transform: translateY(4px);
		transition:
			opacity 0.16s ease,
			transform 0.16s ease;
		white-space: nowrap;
	}

	:root[data-scrolled="true"] .app-topbar .topbar-post-title {
		opacity: 1;
		transform: translateY(0);
	}

	.sidebar-toggle {
		height: 34px;
		border: 1px solid color-mix(in srgb, var(--line), transparent 18%);
		border-radius: 999px;
		background: color-mix(in srgb, var(--card), transparent 10%);
		color: var(--accent-strong);
		cursor: pointer;
		padding: 0 14px;
		font: inherit;
		font-size: 0.86rem;
		font-weight: 800;
		transition:
			border-color 0.16s ease,
			background 0.16s ease,
			transform 0.16s ease;
	}

	.sidebar-toggle:hover {
		transform: translateY(-1px);
	}

	.reader {
		display: grid;
		align-items: start;
		grid-template-columns: minmax(0, 720px) 238px;
		gap: 16px;
		justify-content: center;
	}

	:root[data-sidebar-ready="true"] .reader {
		transition:
			grid-template-columns 0.2s ease,
			gap 0.2s ease;
	}

	:root[data-sidebar-hidden="true"] .reader {
		grid-template-columns: minmax(0, 720px) 0;
		gap: 0;
	}

	:root[data-sidebar-hidden="true"] .sidebar {
		opacity: 0;
		overflow: hidden;
		pointer-events: none;
		transform: translateX(12px);
		visibility: hidden;
	}

	.sidebar-scrim {
		display: none;
	}

	.article-column {
		min-width: 0;
		width: 100%;
	}

	.sidebar {
		position: sticky;
		top: 18px;
		min-width: 0;
		opacity: 1;
		transform: translateX(0);
	}

	:root[data-sidebar-ready="true"] .sidebar {
		transition:
			opacity 0.18s ease,
			transform 0.2s ease,
			visibility 0.2s ease;
	}

	.sidebar-panel {
		display: grid;
		gap: 12px;
		width: 238px;
		border: 0;
		border-left: 1px solid color-mix(in srgb, var(--accent), transparent 74%);
		border-radius: 0;
		background: color-mix(in srgb, var(--panel), transparent 36%);
		box-shadow: none;
		max-height: calc(100vh - 36px);
		overflow-x: hidden;
		overflow-y: auto;
		padding: 14px 0 14px 16px;
	}

	.sidebar-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		color: var(--muted);
		font-size: 0.82rem;
		font-weight: 700;
	}

	.sidebar-meta a {
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--accent-strong);
		padding: 2px 8px;
		text-decoration: none;
	}

	.toc {
		display: grid;
		gap: 4px;
		border-top: 1px solid color-mix(in srgb, var(--line), transparent 24%);
		padding-top: 10px;
	}

	.toc-link {
		position: relative;
		display: block;
		color: var(--muted);
		border-radius: 6px;
		padding: 4px 8px;
		font-size: 0.88rem;
		line-height: 1.45;
		text-decoration: none;
		transition:
			color 0.16s ease,
			transform 0.16s ease;
	}

	.toc-link::before {
		position: absolute;
		top: 50%;
		bottom: auto;
		left: -17px;
		width: 2px;
		height: 14px;
		border-radius: 999px;
		background: transparent;
		content: "";
		transform: translateY(-50%);
		transition: background 0.16s ease;
	}

	.toc-link:hover {
		color: var(--accent-strong);
		transform: translateX(2px);
	}

	.toc-link.active {
		color: var(--accent-strong);
		font-weight: 800;
	}

	.toc-link.active::before {
		background: var(--accent);
	}

	.toc-link.depth-2 {
		margin-left: 10px;
		font-size: 0.84rem;
	}

	.toc-link.depth-3 {
		margin-left: 20px;
		font-size: 0.82rem;
	}

	.toc-link.depth-4 {
		margin-left: 30px;
		font-size: 0.8rem;
	}

	.post {
		border: 0;
		border-radius: 8px;
		background: var(--article);
		box-shadow: 0 6px 20px rgba(29, 41, 40, 0.035);
		padding: 30px 34px 40px;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 10px;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.post-meta a {
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--accent-strong);
		padding: 2px 8px;
		text-decoration: none;
	}

	h1 {
		margin: 0;
		font-size: 1.68rem;
		line-height: 1.25;
		letter-spacing: 0;
	}

	p,
	li {
		color: var(--text);
		line-height: 1.9;
	}

	p {
		margin: 12px 0 0;
	}

	.summary {
		color: var(--muted);
		border-bottom: 1px solid color-mix(in srgb, var(--line), transparent 30%);
		padding-bottom: 16px;
	}

	.content {
		margin-top: 22px;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4) {
		scroll-margin-top: 64px;
	}

	ul {
		margin: 12px 0 0;
		padding-left: 1.2rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4) {
		margin: 22px 0 0;
		letter-spacing: 0;
		line-height: 1.35;
	}

	.content :global(h1) {
		margin-top: 30px;
		font-size: 1.74rem;
		font-weight: 800;
	}

	.content :global(img) {
		display: block;
		width: var(--blog-image-width, min(100%, 760px));
		height: auto;
		margin: 16px auto 0;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--panel);
	}

	.content :global(.code-block) {
		position: relative;
		display: grid;
		margin: 18px 0 0;
		border: 1px solid color-mix(in srgb, var(--line), transparent 18%);
		border-radius: 8px;
		background: #fffefd;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65);
		overflow: visible;
	}

	:root[data-theme="dark"] .content :global(.code-block) {
		background: #fffefd;
		color: #1d2928;
	}

	.content :global(.code-copy) {
		position: absolute;
		top: 10px;
		right: 10px;
		z-index: 4;
		border: 1px solid color-mix(in srgb, var(--line), transparent 10%);
		border-radius: 999px;
		background: color-mix(in srgb, #ffffff, transparent 6%);
		color: #155e63;
		cursor: pointer;
		font: inherit;
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1;
		padding: 7px 10px;
		box-shadow: 0 4px 14px rgba(29, 41, 40, 0.08);
		backdrop-filter: blur(8px);
		transition:
			border-color 0.16s ease,
			color 0.16s ease,
			transform 0.16s ease;
	}

	.content :global(.code-copy:hover) {
		border-color: color-mix(in srgb, var(--accent), var(--line) 40%);
		color: var(--accent-strong);
		transform: translateY(-1px);
	}

	.content :global(pre) {
		overflow: hidden;
		margin: 0;
		border: 0;
		border-radius: 8px;
		padding: 40px 0 14px;
		background: transparent !important;
		color: #1d2928 !important;
		counter-reset: code-line;
	}

	.content :global(code) {
		font-family: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
	}

	.content :global(pre code) {
		display: grid;
		gap: 0;
		color: #1d2928 !important;
		font-size: 0.86rem;
		line-height: 1.68;
		white-space: normal;
	}

	.content :global(pre code span) {
		color: inherit !important;
	}

	.content :global(.code-line) {
		display: grid;
		grid-template-columns: 3.2rem minmax(0, 1fr);
		counter-increment: code-line;
		padding: 0 16px 0 0;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.content :global(.code-line::before) {
		content: counter(code-line);
		position: sticky;
		left: 0;
		align-self: stretch;
		margin-right: 12px;
