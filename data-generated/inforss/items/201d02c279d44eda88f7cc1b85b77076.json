tyle=\"margin-top:10px; margin-bottom:10px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">计算机系</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:113px; padding:0cm 7px 0cm 7px; height:35px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:10px; margin-bottom:10px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">2026</span></span><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">年春</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:142px; padding:0cm 7px 0cm 7px; height:35px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:10px; margin-bottom:10px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">美国</span></span></span></span></p> <p style=\"margin-top:10px; margin-bottom:10px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">罗切斯特大学</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:142px; padding:0cm 7px 0cm 7px; height:35px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:10px; margin-bottom:10px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">新加坡</span></span></span></span></p> <p style=\"margin-top:10px; margin-bottom:10px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">新加坡国立大学</span></span></span></span></p> </td> \n   </tr> \n  </tbody> \n </table> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-indent:24.0pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0pt\">联系人：湛勇智，联系电话：62780499，电子邮件：yjsypyc@tsinghua.edu.cn</span></span></span></p> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-align:right; text-indent:24.0pt\"> </p> \n <p style=\"text-align:right; text-indent:24.0pt\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0pt\">研究生院</span></span></span></p> \n <p style=\"text-align:right; text-indent:24.0pt\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0pt\">2026</span><span style=\"font-size:12.0pt\">年7月1日</span></span></span></p> \n <p style=\"text-align:justify\"> </p> \n</div>",
