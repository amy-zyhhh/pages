  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-align:right\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\"><font face=\"宋体\">清资发〔</font><font face=\"宋体\">2026〕25号</font></span></span></span></span></span></p> \n <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\"><font face=\"宋体\">各单位、各位师生：</font></span></span></span></span></span></p> \n <p style=\"margin-top:7px; margin-bottom:7px; text-indent:28.0000pt; text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\"><font face=\"宋体\">为进一步优化校园办事服务流程，提升办事效率，学校师生综合服务大厅于</font><font face=\"宋体\">2026年7月1日启动运行。根据学校统一工作安排，资产处以下住房业务自2</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\">026</span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\"><font face=\"宋体\">年</font><font face=\"宋体\">8月1</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\">7</span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\"><font face=\"宋体\">日（星期一）起调整到师生综合服务大厅专项服务区</font><font face=\"宋体\">Z</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\">1</span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\"><font face=\"宋体\">、</font><font face=\"宋体\">Z</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\">2</span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#333333\"><font face=\"宋体\">窗口办理。</font></span></span></span></span></span></p> \n <table class=\"Table\" style=\"border-collapse:collapse; width:553px; border:none; font-family:\"Times New Roman\"; font-size:13px\"> \n  <tbody> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:1px solid #000000; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><span style=\"font-weight:bold\"><font face=\"宋体\">序号</font></span></span></span></span></b></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:1px solid #000000; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><span style=\"font-weight:bold\"><font face=\"宋体\">师生服务大厅进驻事项名称</font></span></span></span></span></b></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">1</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">教师周转公寓申请、办理入住（含领取房卡）、协议签订、退房验收、费用结算</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">2</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">博士后公寓申请、办理入住（含领取房卡）、协议签订、退房验收、费用结算</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">3</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">高访公寓协议签订、房租交纳、费用结算</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">4</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">教职工住房情况调查（含表格填报及审核）</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">5</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">自交户缴纳房租、各类住房的凭证自交租金及相关费用的结算</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">6</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">教职工、博士后离校住房手续办理</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">7</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">公租房申请、缴费、协议签署等手续办理</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">8</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">已购公房的产权回购及承租公房的使用权回购办理</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">9</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">已购公房的继承等产权变更的手续办理</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">10</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">住宅专项维修资金缺额补缴及缴存证明开具</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">11</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">住房证明办理</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">12</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">已购职工住宅不动产权证办理</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">13</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">住房补贴的审核、确认</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:1px solid #000000\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">14</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid #000000; width:478px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-left:none\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"宋体\">博士后与高访公寓维修接报</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid #000000; width:74px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid #000000; border-l