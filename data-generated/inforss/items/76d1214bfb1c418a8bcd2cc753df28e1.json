  "title": "关于做好新生入学季反诈及校园推销防范工作的提示",
  "date": "20260818",
  "time": "2026-08-18 20:53",
  "category": "办公通知",
  "department": "保卫部",
  "sourceId": "tsinghua-info-all",
  "sourceName": "清华信息门户",
  "source": "清华信息门户",
