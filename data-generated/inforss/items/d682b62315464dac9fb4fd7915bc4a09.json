  "summary": "",
  "preview": "",
  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">清华大学休闲长廊二层</font><font face=\"华文仿宋\">B2房间为清华大学资产，学校拟对本房屋以公开招租方式进行出租。项目情况及具体要求如下。</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">一、项目简介</font></span></span></b></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">休闲长廊位于清华大学中部，总建筑面积为</font><font face=\"华文仿宋\">1485.00平方米，为给清华大学校内学生提供便捷的健身服务，学校拟将休闲长廊二层B2房间设为健身房，并对该服务项目进行公开招租。</font></span></span></span></span></span></span></span></p> \n <p style=\"text-indent:0.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">二、出租房屋信息及业务范围</font></span></span></b></span></span></span></p> \n <table class=\"Table\" style=\"border-collapse:collapse; border:none; font-family:\"Times New Roman\"; font-size:13px\"> \n  <tbody> \n   <tr> \n    <td style=\"border-bottom:1px solid black; width:104px; padding:0px 7px 0px 7px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">资产名称</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:86px; padding:0px 7px 0px 7px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">资产编号</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:111px; padding:0px 7px 0px 7px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">出租房屋名称</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:50px; padding:0px 7px 0px 7px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">楼层</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:94px; padding:0px 7px 0px 7px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">建筑面积</font><font face=\"华文仿宋\">/m</font></span></span><sup><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><span style=\"vertical-align:super\">2</span></span></span></sup></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:113px; padding:0px 7px 0px 7px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">招租底价</font><font face=\"华文仿宋\">/(元/m</font></span></span><sup><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><span style=\"vertical-align:super\">2</span></span></span></sup><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">/天)</font></span></span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid black; width:104px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">休闲长廊</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:86px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\">0427</span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:111px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">休闲长廊二层</font><font face=\"华文仿宋\">B2房间</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:50px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\">2</span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:94px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">188.00</font></span></span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:113px; padding:0px 7px 0px 7px; border-top:none; border-right:1px solid black; border-left:1px solid black\"> <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">4.15</font></span></span></span></span></span></p> </td> \n   </tr> \n  </tbody> \n </table> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">业务范围：健身房（仅限轻体育运动</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">，</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">不能有重型设备）。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">备注：报价低于底价者不能进入评审环节。</font></span></span></span></span></span></p> \n <p style=\"text-indent:0.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">三、报名条件</font></span></span></b></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">1. 具有相应的经营和管理能力的企业和个体工商户均可报名。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\">2.</span></span> <span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">仅接受主营业务为上述目标业态的企业和个体工商户进行报名，本项目不接受联合体应租。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">3. 近三年内，在经营活动中没有重大违法记录。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">4. 遵守国家法律法规和学校各项规章制度，接受上级部门及学校管理、监督、检查。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">5. 经营过程中，保持环境整洁、干净、优雅，严禁经营一切吵闹、污染、低俗和非法的项目。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">6. </font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">本项目所称</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">“</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">仅限轻体育运动</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">”</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">：指以自重、小负荷器械、团体课程为主的瑜伽、普拉提、团操、体态训练、轻有氧训练等健身服务；允许配置跑步机、椭圆机、动感单车等有氧设备，允许配置瑜伽垫、弹力带、</font><font face=\"华文仿宋\">5kg 及以下小哑铃、普拉提核心床等轻量器械。严禁配置史密斯架、深蹲架、卧推架、腿举机、龙门架等大型抗阻力量器械，严禁开展大重量负重撸铁、力量举等增肌力量训练业务</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">7</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">. 租借方对本房屋进行装修改造的方案须报清华大学相关部门审批后方可施工，不得影响消防设施。所有针对本房屋环境和条件进行的改造产生的费用由租借方负担，学校不对本房屋做任何投入。</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">本项目应租单位用电负荷不得超过该</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">房间</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">额定标准。</font></span></span></span></span></span></span></span></p> \n <p style=\"text-indent:28.5000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">8</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">. 自主经营、自负盈亏，独立承担与经营相关的经济、法律责任。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.5000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">9</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">. 同意按《清华大学公有房屋出租出借管理办法》与学校签订房屋租赁合同，并按合同规定交纳房租与履约保证金。同时，按有关部门规定自行交纳物业、供暖、水、电等费用。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.5000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">10</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">. 本房屋无装修免租期，租金支付方式为至少押二（月）付六（月）。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.5000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">1</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">1</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">. 本房屋不允许转租转借。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.5000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">1</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">2</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">. 法律、行政法规规定的其他条件。</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">四、报名提交资料及要求</font></span></span></b></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">1. 法定代表人身份证复印件、授权委托书；经办人身份复印件（报名时核查原件）。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">2. 企业营业执照副本（复印件加盖公章）。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">3. 企业出具重要事项承诺书（见附件1）。（需提供企业承诺说明加盖公章；</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">前</font>30日内未被“信用中国”(www.creditchina.gov.cn)列入失信被执行人名单、重大税收违法案件当事人名单的截图证明；前30日内未被“国家企业信用信息公示系统”(www.gsxt.gov.cn)列入严重违法失信企业名单（黑名单）的截图证明</span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">。上述材料缺一不可。</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">）</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\">4. 印刷版（纸质版）企业介绍，内容至少包含实缴资本情况</span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">（须登录国家企业信用信息公示系统，打印实缴公示信息，或提供验资报告）</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">、社保缴纳人数情况</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">（需提供企业参保地人社局官网或国家社会保险公共服务平台下载的证明文件）</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">、已经营年限、近</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">一</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">年营业额情况</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">（与房屋业务范围相关的）</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">、管理制度（</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">如已取得质量管理体系认证（</font><font face=\"华文仿宋\">I</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\">SO</span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">系列）或同等行业管理体系认证需提供证明文件</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">）、</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">清华营销及服务方案（包括但不限于信息共享、育人服务、消费折扣、公益捐赠等）</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">，并附相关证明文件。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">5. 本房屋经营方案，包含但不限于经营内容、意向租金标准，拟销售品类及价格，对消费者优惠力度等。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">注：</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">1.</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">分公司等不具有独立法人资格的分支机构参与报名的，除上述材料外还需提供具有独立法人资格的总公司出具的有效授权文件。个体工商户参与报名的，不要求具备独立法人资格，凭有效营业执照及经营者身份证明即可。</font></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\">2.</span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">以上证书、批件均须提供加盖单位公章的复印件</font><font face=\"华文仿宋\">3套，用于备案。提交电子版1份和纸质版文件3份，纸质版资料请装订在一起，电子版须与纸质版装入一个密封信袋内，封面标注：项目名称、单位名称（加盖公章）、联系人、联系电话。我单位将对所有报名资料进行审核，综合考虑资质、经营内容、设计方案等因素遴选承租单位。所有报名资料不予退还。报名单位须审慎对待报名材料，所有材料数据务必真实准确，如发现有造假行为，则该单位将被加入黑名单，学校将保留追责索赔的权利。</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">五、报名时间与地点</font></span></span></b></span></span></span></p> \n <p style=\"margin-left:93px; text-indent:-70.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">报名时间：</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\">2026-</span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">08</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\">-</span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">25</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">—2026-</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">09</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\">-</span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">07</font></span></span></span></span></span></span></span></p> \n <p style=\"margin-left:93px; text-indent:-70.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">现场勘查</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">时间：</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\">2026-0</span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">8</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\">-</span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">31</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"> <font face=\"华文仿宋\">下午</font>14:00-16:00</span></span></span></span></span></span></span></p> \n <p style=\"margin-left:93px; text-indent:-70.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">报名地点：</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">清华大学紫荆服务楼</font>101室</span></span></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">联系人：</font></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">董老师、赵老师</font></span></span></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:22.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">联系电话</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\"><font face=\"华文仿宋\">：</font></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:华文仿宋\"><span style=\"color:#333333\">62795778</span></span></span></span></span></span></span></p> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-indent:235.6000pt; text-align:left\"> </p> \n <p style=\"text-align:right\"><span style=\"font-size:10.5pt\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">清华大学</font></span></span></b><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">学生社区管理服务中心</font></span></span></b></span></span></span></p> \n <p style=\"margin-right:9px; text-indent:42.0500pt; text-align:right\"><span style=\"font-size:10.5pt\"><span style=\"word-break:break-all\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">清华大学资产</font></span></span></b><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">管理</font></span></span></b><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">处</font></span></span></b></span></span></span></span></p> \n <p style=\"margin-right:9px; text-indent:42.0500pt; text-align:right\"><span style=\"font-size:10.5pt\"><span style=\"word-break:break-all\"><span style=\"line-height:20.0000pt\"><span style=\"font-family:\"Times New Roman\"\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:华文仿宋\"><font face=\"华文仿宋\">2026年08