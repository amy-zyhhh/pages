  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-align:justify\"><span style=\"font-family:SimSun;\"><span style=\"font-size:10.5pt\"><span style=\"font-size:10.5000pt\">2026届本科毕业生：</span></span></span></p> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-align:justify\"><span style=\"font-family:SimSun;\"><span style=\"font-size:10.5pt\"><span style=\"font-size:10.5000pt\">请2026届本科毕业生及时登录信息门户浏览、下载毕业照片电子版（可用于冲洗照片）。</span></span></span></p> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-align:justify\"><span style=\"font-family:SimSun;\"><span style=\"font-size:10.5pt\"><span style=\"font-size:10.5000pt\">下载路径：信息门户登录，在上方搜索框中输入“照片查看”搜索后，点击下方“照片查看”进入，在毕业照片处点击鼠标右键选择“图片另存为”即可，请同学们及时下载并注意妥善保存。</span></span></span></p> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-align:justify\"><span style=\"font-family:SimSun;\"><span style=\"font-size:10.5pt\"> </span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-family:SimSun;\"><span style=\"font-size:10.5pt\"><span style=\"font-size:10.5000pt\">联系人：张一，62784319，jwcjwk@tsinghua.edu.cn</span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-family:SimSun;\"><span style=\"font-size:10.5pt\"><span style=\"font-size:10.5000pt\">教务处学籍管理办公室</span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-family:SimSun;\"><span style=\"font-size:10.5pt\"><span style=\"font-size: 10.5pt;\">202</span><span style=\"font-size: 10.5pt;\">6</span><span style=\"font-size: 10.5pt;\"><font style=\"font-family: 宋体;\">年6月9日</font></span></span></span></p> \n</div>",
