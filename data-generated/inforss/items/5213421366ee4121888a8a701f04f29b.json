  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-indent:29.2500pt; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">好奇文明秩序中的公平正义与法治内核？</font></span></span></span></span></span></p> \n <p style=\"text-indent:29.2500pt; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">想了解国际法准则、商业交易法律逻辑、知识产权保护？</font></span></span></span></span></span></p> \n <p style=\"text-indent:29.2500pt; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">或是遇到劳动合同、网络纠纷、婚姻家庭等身边法律难题？</font></span></span></span></span></span></p> \n <p style=\"margin-top:16px; text-indent:21.0000pt; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">欢迎参与</font></span></span><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">清华大学法治思维与能力提升项目</font></span></span></b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">！该项目于</font><font face=\"宋体\">2017年由研究生院、法学院联合设计实施，面向全校在校生</font><font face=\"宋体\">（包括本科生和研究生）</font><font face=\"宋体\">开放，</font></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">提供</font></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">十余门法学课程。学习法治原理与思维方法，提升法律素养与实务能力，成为法治中国的践行者。</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:黑体\"><span style=\"line-height:125%\"><font face=\"黑体\">一、项目特色</font></span></span></span></b></span></span></span></p> \n <p style=\"text-indent:24.0000pt; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">本项目开设了包括法律入门、特色方向、</font><font face=\"宋体\">法治实践</font><font face=\"宋体\">三个模块的课程。法律入门模块向学生提供法律基础理论、法制史和国际法等方面的基本知识。特色方向模块主要包括民商经济法治方向、知识产权与科技法治方向、涉外法治方向等，满足不同专业学生的不同需求。法治实践模块既提供法律文书写作、法律谈判、模拟法庭训练等课程，也安排学生去法律实务部门参观等实践活动，加深学生对法律实务环节的认识和理解。</font></span></span></span></span></span></p> \n <p style=\"text-indent:24.0000pt; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">本项目课程均由清华大学法学院教师担任课程负责人，负责教科书撰写、课堂材料准备和教学组织工作，并邀请法院、检察院、知名律所等实务界人士及校友参与课程教学。院内外教师共同授课，以保证教学内容的专业性，理论与实践紧密结合。</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><b><span style=\"font-size:14.0000pt\"><span style=\"font-family:黑体\"><span style=\"line-height:125%\"><font face=\"黑体\">二、课程信息</font></span></span></span></b></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">I．法律入门基础课程（&ge;3学分）</font></span></span></b></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">1.</font></span></span> <span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">宪法学</font> </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"> 40660353  </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">3学分（秋季）</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">2.</font></span></span> <span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">刑法总论</font> </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">70660133</span></span> <span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"> 3</span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">学分（秋季）</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">3.</font></span></span> <span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">法学绪论</font> </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">30660082</span></span> <span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"> <font face=\"宋体\">2学分（秋季）</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">4.</font></span></span> <span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">中国法制史学</font>  </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">80660142</span></span> <span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">2</span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">学分（秋季）</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">5．主权与人权 </font></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">00660253   3</span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">学分（春季）</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">6</font></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">. </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">法律思维</font> </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"> 00660263    3</span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">学分</font> <font face=\"宋体\">（春季）</font></span></span></span></span></span></p> \n <p style=\"margin-top:16px; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">II. 特色课程（&ge;</font></span></span></b><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">2</span></span></b><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">学分）</font></span></span></b></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">民商经济法治方向</font></span></span></b><b> </b><b> </b><b> </b></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">7</font></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">. </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">合同法</font> </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"> 40660283  3</span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">学分（春季）</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">8</font></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">. </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">侵权行为法</font> </span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"> 40661204</span></span>  <span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">4</span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">学分（秋季）</font></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:12pt\"><span style=\"line-height:125%\"><span style=\"font-family:Cambria\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><font face=\"宋体\">9</font></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\">. </span></s