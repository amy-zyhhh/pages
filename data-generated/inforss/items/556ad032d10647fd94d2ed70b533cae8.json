  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-indent:24.0pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:12.0pt\">经博士生本人申请、指导教师和院系审核同意、研究生院核准并公示，同意以下已获得博士生出国（境）访学基金资助博士生的改派申请，现公布如下。</span></span></span></p> \n <p style=\"text-indent:21.0pt; text-align:justify\"> </p> \n <table class=\"MsoTableGrid\" style=\"width:586px; border-collapse:collapse; border:none\" width=\"586\"> \n  <tbody> \n   <tr> \n    <td style=\"border-bottom:1px solid black; width:94px; padding:0cm 7px 0cm 7px; height:41px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><b><span style=\"font-size:11.0pt\"><span style=\"font-family:黑体\">申请人姓名</span></span></b></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:94px; padding:0cm 7px 0cm 7px; height:41px; border-top:1px solid black; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><b><span style=\"font-size:11.0pt\"><span style=\"font-family:黑体\">院系名称</span></span></b></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:95px; padding:0cm 7px 0cm 7px; height:41px; border-top:1px solid black; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><b><span style=\"font-size:11.0pt\"><span style=\"font-family:黑体\">原录取批次</span></span></b></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:151px; padding:0cm 7px 0cm 7px; height:41px; border-top:1px solid black; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><b><span style=\"font-size:11.0pt\"><span style=\"font-family:黑体\">原出访地</span></span></b></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:151px; padding:0cm 7px 0cm 7px; height:41px; border-top:1px solid black; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><b><span style=\"font-size:11.0pt\"><span style=\"font-family:黑体\">新出访地</span></span></b></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid black; width:94px; padding:0cm 7px 0cm 7px; height:35px; border-top:none; border-right:1px solid black; border-left:1px solid black\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">朱睿佳</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:94px; padding:0cm 7px 0cm 7px; height:35px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">建筑学院</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:95px; padding:0cm 7px 0cm 7px; height:35px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">2026</span></span><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">年春</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:151px; padding:0cm 7px 0cm 7px; height:35px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">加拿大</span></span></span></span></p> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">不列颠哥伦比亚大学</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:151px; padding:0cm 7px 0cm 7px; height:35px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">美国</span></span></span></span></p> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">加州大学伯克利分校</span></span></span></span></p> </td> \n   </tr> \n   <tr> \n    <td style=\"border-bottom:1px solid black; width:94px; padding:0cm 7px 0cm 7px; height:99px; border-top:none; border-right:1px solid black; border-left:1px solid black\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">张书宁</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:94px; padding:0cm 7px 0cm 7px; height:99px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">网络研究院</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:95px; padding:0cm 7px 0cm 7px; height:99px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">2025</span></span><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">年秋</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:151px; padding:0cm 7px 0cm 7px; height:99px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">德国</span></span></span></span></p> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">亥姆霍兹研究中心</span></span></span></span></p> </td> \n    <td style=\"border-bottom:1px solid black; width:151px; padding:0cm 7px 0cm 7px; height:99px; border-top:none; border-right:1px solid black; border-left:none\"> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">西班牙</span></span></span></span></p> <p style=\"margin-top:8px; margin-bottom:8px; text-align:center\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:11.0pt\"><span style=\"font-family:宋体\">国家研究署和瓦伦西亚理工大学联合研究中心</span></span></span></span></p> </td> \n   </tr> \n  </tbody> \n </table> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-indent:24.0pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"font-fami