  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-indent:28.0000pt; text-align:justify\"><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\"><span style=\"line-height:150%\"><span style=\"line-height:150%\">因学堂路路面维修项目的需要,计划对学堂路南九楼路口、南四楼路口、学堂路与日新路交叉路口道路进行道路维修施工作业。计划于8月5日至6日早6时至晚6时，占用学堂路与日新路交叉路口、南四楼路口、南九楼路口进行道路维修封闭施工作业。</span></span></span></span><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\"><span style=\"background:#ffffff\">请过往车辆和行人绕行，注意安全。</span></span></span></p> \n <p style=\"text-indent:28.0000pt\"><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\"><span style=\"background:#ffffff\">因作业施工给师生员工工作、学习造成不便，深表歉意！感谢大家的理解配合！ </span></span></span></p> \n <p style=\"text-indent:28.0000pt\"><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\"><span style=\"line-height:150%\"><span style=\"line-height:150%\">修缮校园管理中心项目联系人：姚工   电话（手机）：13810789108</span>  </span></span></span></p> \n <p style=\"text-indent:28.0000pt\"><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\"><span style=\"line-height:150%\"><span style=\"line-height:150%\">作业施工单位现场负责人：赵工      电话（手机）：13691294658</span> </span></span></span></p> \n <p style=\"text-indent:28.0000pt\"><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\"><span style=\"line-height:150%\"><span style=\"line-height:150%\">保卫处交通办：62782602</span></span></span></span></p> \n <p style=\"text-indent: 28pt; text-align: right;\"><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\">修缮校园管理中心</span></span></p> \n <p style=\"text-indent: 28pt; text-align: right;\"><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\">保卫处</span></span></p> \n <p style=\"text-indent: 28pt; text-align: right;\"><span style=\"font-size:18px;\"><span style=\"font-family:SimSun;\"><span style=\"word-break:break-all\"><span style=\"line-height:150%\"><span style=\"line-height:150%\">2026年8月4日</span></span></span></span></span>