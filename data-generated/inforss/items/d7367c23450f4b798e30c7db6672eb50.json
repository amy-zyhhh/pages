  "title": "关于配合推进食品安全“互联网+AI监管”系统接入的通知",
  "date": "20260605",
  "time": "2026-06-05 16:33",
  "category": "办公通知",
  "department": "商贸中心",
  "sourceId": "tsinghua-info-xs",
