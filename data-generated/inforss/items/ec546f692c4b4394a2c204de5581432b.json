  "title": "2027年国别和区域研究人才支持计划（项目制）立项申报通知",
  "date": "20260813",
  "time": "2026-08-13 11:30",
  "category": "办公通知",
  "department": "研究生院",
  "sourceId": "tsinghua-info-all",
  "sourceName": "清华信息门户",
  "source": "清华信息门户",
