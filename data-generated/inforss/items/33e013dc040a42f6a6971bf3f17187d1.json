  "title": "关于各单位申报2027年公务用车购置预算的通知",
  "date": "20260615",
  "time": "2026-06-15 15:58",
  "category": "办公通知",
  "department": "资产处",
  "sourceId": "tsinghua-info-all",
  "sourceName": "清华信息门户",
