  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:150%\"><span style=\"font-family:Calibri\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">尊敬的各位</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">老师</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">：</font></span></span></span></span></span></span></p> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-indent:24.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"text-autospace:ideograph-numeric\"><span style=\"line-height:150%\"><span style=\"font-family:Calibri\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">合同管理与学校经济运行</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">息息</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">相关，是保障学校各项事业平稳有序发展的重要支撑，更是一线教职工开展教学科研、项目合作、日常办公等工作的重要</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">服务事项</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">。</font></span></span></span></span></span></span></span></p> \n <p style=\"text-indent:24.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"text-autospace:ideograph-numeric\"><span style=\"line-height:150%\"><span style=\"font-family:Calibri\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">信息化工作办公室</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">和各归口部门已</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">初步完成合同管理系统的整体规划与设计</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">。</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">为</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">更好</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">贴合一线工作需求，</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">本期</font><font face=\"宋体\">“信息化面对面”再次聚焦合同管理，组织召开专题交流会，</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">广泛征集一线</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">教师</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">及各归口部门的意见建议，</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">持续</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">打磨系统规划方案。</font></span></span></span></span></span></span></span></p> \n <p style=\"text-indent:24.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"text-autospace:ideograph-numeric\"><span style=\"line-height:150%\"><span style=\"font-family:Calibri\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">诚挚邀请您</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">关注学校合同管理建设，欢迎积极参与。</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">关注此事但</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">无法线下参会的</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">老师</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">，可通过</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">以下</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">二维码线上提交意见建议，我们将逐条梳理研究，充分吸纳</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">，</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">融入系统建设工作。</font></span></span></span></span></span></span></span></p> \n <p style=\"text-indent:24.0000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"text-autospace:ideograph-numeric\"><span style=\"line-height:150%\"><span style=\"font-family:Calibri\"><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">衷心感谢各位老师的积极参与和大力支持，期待大家踊跃建言献策，共同助力学校信息化建设提质增效！</font></span></span></span></span></span></span></span></p> \n <p style=\"text-align:justify\"> </p> \n <p style=\"text-align:justify\"> </p> \n <p style=\"margin-left:32px; text-indent:-24.1000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:150%\"><span style=\"font-family:Calibri\"><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><span style=\"font-weight:bold\"><font face=\"宋体\">会议时间：</font></span></span></span></span></b><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><span style=\"font-weight:bold\"><font face=\"宋体\">8</font></span></span></span></span></b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">月</font><font face=\"宋体\">21日周五 13:30-15:00</font></span></span></span></span></span></span></p> \n <p style=\"margin-left:32px; text-indent:-24.1000pt; text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:150%\"><span style=\"font-family:Calibri\"><b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><span style=\"font-weight:bold\"><font face=\"宋体\">参会地点：</font></span></span></span></span></b><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">老环境</font></span></span></span><span style=\"font-size:12.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">楼</font><font face=\"宋体\">103会议室</font></span></span></span></span></span></span></p> \n <p style=\"margin-left:32px; text-indent:-24.1000pt; text-align:left\"><span style=\"font-size:10.5pt\"><span style=\"line-height:150%\"><span style=\"font-family:Calibri