  "title": "2027年留学基金委艺术类人才培养特别项目（项目制）申报通知",
  "date": "20260813",
  "time": "2026-08-13 11:24",
  "category": "办公通知",
  "department": "研究生院",
  "sourceId": "tsinghua-info-all",
