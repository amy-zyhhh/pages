  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"margin-top:8px; margin-right:-4px; margin-left:1px; text-align:justify; text-indent:26.95pt\"><span style=\"font-size:10.5pt\"><span style=\"text-justify:inter-ideograph\"><span style=\"line-height:179%\"><span style=\"font-family:Arial,sans-serif\"><span style=\"color:black\"><span style=\"font-size:14.0pt\"><span style=\"line-height:179%\"><span style=\"font-family:宋体\"><span style=\"letter-spacing:-.05pt\">因工物馆扩馆排风管道维修作业需要，计划于2026年6月29日13时30分至15时，维修升降车占用工物馆扩馆北侧部分道路半幅路段进行作业。</span></span></span></span></span></span></span></span></span></p> \n <p style=\"margin-right:-4px; margin-left:1px; text-align:justify; text-indent:26.95pt\"><span style=\"font-size:10.5pt\"><span style=\"text-justify:inter-ideograph\"><span style=\"line-height:179%\"><span style=\"font-family:Arial,sans-serif\"><span style=\"color:black\"><span style=\"font-size:14.0pt\"><span style=\"line-height:179%\"><span style=\"font-family:宋体\"><span style=\"letter-spacing:-.05pt\">为保障安全，在此期间该路段将采取半幅路临时管制措施，请来往行人、车辆注意安全。</span></span></span></span></span></span></span></span></span></p> \n <p style=\"margin-top:8px; margin-right:-4px; margin-left:1px; text-align:justify; text-indent:26.95pt\"><span style=\"font-size:10.5pt\"><span style=\"text-justify:inter-ideograph\"><span style=\"line-height:179%\"><span style=\"font-family:Arial,sans-serif\"><span style=\"color:black\"><span style=\"font-size:14.0pt\"><span style=\"line-height:179%\"><span style=\"font-family:宋体\"><span style=\"letter-spacing:-.05pt\">因作业施工给师生员工工作、学习造成不便，深表歉意，感谢大家的理解配合！</span></span></span></span></span></span></span></span></span></p> \n <p style=\"margin-top:8px; margin-right:-4px; margin-left:1px; text-align:justify; text-indent:26.95pt\"><span style=\"font-size:10.5pt\"><span style=\"text-justify:inter-ideograph\"><span style=\"line-height:179%\"><span style=\"font-family:Arial,sans-serif\"><span style=\"color:black\"><span style=\"font-size:14.0pt\"><span style=\"