  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-indent:32.0000pt; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"text-autospace:ideograph-numeric\"><span style=\"text-justify:inter-ideograph\"><span style=\"line-height:28.0000pt\"><span style=\"font-family:宋体\"><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">根据</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">学校</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">《新增研究生培养项目设置与管理办法》，研究生院于</font><font face=\"仿宋\">20</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">26</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">年</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">6</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">月</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">17</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">日组织了专业学位研究生培养项目专家</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">评审</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">会，其中</font><font face=\"仿宋\">“</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">集成电路工程</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">”“人工智能赋能科学”“金融硕士”“金融EMBA”等</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">4</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">个专业</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">硕士</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">项目</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">及</font><font face=\"仿宋\">“</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">财经领军人才</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">”</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">专业博士项目获得与会专家三分之二</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">及</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">以上同意票数，通过</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">评审</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">。现就项目</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">开办及续办</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">在全校公开征集意见，项目简介请见附件。</font></span></span></span></span></span></span></span></span></p> \n <p style=\"text-indent:32.0000pt; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"text-autospace:ideograph-numeric\"><span style=\"text-justify:inter-ideograph\"><span style=\"line-height:28.0000pt\"><span style=\"font-family:宋体\"><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">如需了解项目详细情况，请到研究生院专业学位教育办公室（</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">焊接馆</font><font face=\"仿宋\">212</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">）查阅项目报告。公开征集意见时间截</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">至</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">202</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">6</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">年</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span style=\"color:#000000\"><font face=\"仿宋\">6</font></span></span></span><span style=\"font-size:16.0000pt\"><span style=\"font-family:仿宋\"><span styl