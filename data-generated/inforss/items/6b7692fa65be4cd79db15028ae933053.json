ify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:15.0000pt\"><span style=\"font-family:等线\"><span style=\"font-size:9.0000pt\"><span style=\"font-family:'Times New Roman'\"><span style=\"color:#000000\"><font face=\"宋体\">办公时间</font>: <font face=\"宋体\">周一至周五</font><font face=\"Times New Roman, Times, serif\">  </font><font face=\"宋体\">上午</font><font face=\"Times New Roman, Times, serif\">8</font><font face=\"宋体\">：</font><font face=\"Times New Roman, Times, serif\">00</font><font face=\"宋体\">－</font><font face=\"Times New Roman, Times, serif\">12:00</font><font face=\"宋体\">，下午</font><font face=\"Times New Roman, Times, serif\">1:00</font><font face=\"宋体\">－</font><font face=\"Times New Roman, Times, serif\">5</font><font face=\"宋体\">：</font><font face=\"Times New Roman, Times, serif\">00   </font></span></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:15.0000pt\"><span style=\"font-family:等线\"> </span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:15.0000pt\"><span style=\"font-family:等线\"> </span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"line-height:15.0000pt\"><span style=\"font-family:等线\"><span style=\"font-size:9.0000pt\"><span style=\"font-family:'Times New Roman'\"><span style=\"color:#000000\">                     <font face=\"宋体\">注册中心</font></span></span></span></span></span></span></p> \n <p style=\"text-align:justify\"><span style=\"font-size:10.5pt\"><span style=\"font-family:等线\"><span style=\"font-size:9.0000pt\"><span style=\"font-family:'Times New Roman'\"><span style=\"color:#000000\">                     202</span></span></span><span style=\"font-size:9.0000pt\"><span style=\"font-family:宋体\"><span style=\"color:#000000\"><font face=\"Times New Roman, Times, serif\">6.</font></span></span></span><span style=\"font-size:9.0000p