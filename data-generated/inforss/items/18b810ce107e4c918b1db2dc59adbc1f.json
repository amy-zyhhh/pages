  "title": "清华大学蓝旗营商业公建QH2-2房屋公开招租公告",
  "date": "20260803",
  "time": "2026-08-03 11:34",
  "category": "招标招租",
  "department": "资产处",
  "sourceId": "tsinghua-info-all",
