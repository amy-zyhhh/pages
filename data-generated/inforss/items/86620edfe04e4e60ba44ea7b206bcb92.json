  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-align:center\"> </p> \n <p style=\"text-indent:28.0000pt\"><span style=\"font-size:18px;\"><span class=\"xiangqingchakan\"><span style=\"margin-right:75px;text-align:right;\"><span style=\"line-height:150%;\"><span style=\"font-family:宋体;\"><font face=\"仿宋_GB2312\">由于美术学院教学楼外墙玻璃更换项目施工需要，光华路美术学院教学楼过街楼南端半幅道路部分区域计划于2026年6月7日上午9时至12时进行施工作业（具体位置见附图）。施工期间，此路段将安排专人疏导指挥交替放行，请过往行人、车辆注意安全。</font></span></span></span></span></span></p> \n <p><span style=\"font-size:18px;\"><span class=\"xiangqingchakan\"><span style=\"margin-right:75px;text-align:right;\"><span style=\"line-height:150%;\"><span style=\"font-family:宋体;\"><font face=\"仿宋_GB2312\">       因施工给师生员工工作、学习及生活造成不便深表歉意！感谢大家的理解和支持！</font></span></span></span></span></span></p> \n <p> </p> \n <p><span style=\"font-size:18px;\"><span class=\"xiangqingchakan\"><span style=\"margin-right:75px;text-align:right;\"><span style=\"line-height:150%;\"><span style=\"font-family:宋体;\"><font face=\"仿宋_GB2312\">美术学院联系人：尹老师 18514697020</font></span></span></span></span></span></p> \n <p><span style=\"font-size:18px;\"><span class=\"xiangqingchakan\"><span style=\"margin-right:75px;text-align:right;\"><span style=\"line-height:150%;\"><span style=\"font-family:宋体;\"><font face=\"仿宋_GB2312\">作业施工单位现场负责人：蔡工 13910236386</font></span></span></span></span></span></p> \n <p><span style=\"font-size:18px;\"><span class=\"xiangqingchakan\"><span style=\"margin-right:75px;text-align:right;\"><span style=\"line-height:150%;\"><span style=\"font-family:宋体;\"><font face=\"仿宋_GB2312\">保卫处交通办联系电话：62782602</font></span></span></span></span></span></p> \n <p> </p> \n <p><span style=\"font-size:18px;\"><span class=\"xiangqingchakan\"><span style=\"margin-right:75px;text-align:right;\"><span style=\"line-height:150%;\"><span style=\"font-family:宋体;\"><font face=\"仿宋_GB2312\">附件：现场示意图 </font></span></span></span></span></span></p> \n <p> </p> \n <p> </p> \n <p style=\"margin-right: 75px; 