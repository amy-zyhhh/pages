  "contentHtml": "<div class=\"xiangqingchakan\"> \n <p style=\"text-align:center\"> </p> \n <p style=\"text-indent:28.0000pt\"><span style=\"font-size:12pt\"><span style=\"line-height:150%\"><span style=\"font-family:宋体\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">因</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">家属区公共区域道路</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">树木</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">修剪施工</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">需要，</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">计划将于</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\">2026年7月2</span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">2</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">日至</font>7月2</span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">8</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">日对附小东门</font>-老年活动中心、中1楼-胜因院30号、西南门-西南居委会三段道路</span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">的双向道路</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">进行</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">封闭作业。</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><span style=\"color:#333333\"><span style=\"letter-spacing:0.0000pt\"><span style=\"font-style:normal\"><font face=\"宋体\">封闭施工将采用分段、渐进方式进行，以避免全路段同时封闭带来的交通影响</font></span></span></span></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><span style=\"color:#333333\"><span style=\"letter-spacing:0.0000pt\"><span style=\"font-style:normal\"><font face=\"宋体\">。</font></span></span></span></span></span></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt\"><span style=\"font-size:12pt\"><span style=\"line-height:150%\"><span style=\"font-family:宋体\"><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><span style=\"color:#000000\"><font face=\"宋体\">为保障安全，采取封闭断路管理措施，</font></span></span></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><span style=\"color:#000000\"><font face=\"宋体\">具体时间和路段如下：</font></span></span></span></span></span></span></span></span></p> \n <p style=\"text-indent:28.0000pt\"><span style=\"font-size:12pt\"><span style=\"line-height:150%\"><span style=\"font-family:宋体\"><span style=\"font-size:14.0000pt\"><span style=\"background:#ffffff\"><span style=\"font-family:Calibri\"><span style=\"line-height:150%\"><span style=\"color:#000000\"><font face=\"Calibri\">①</font></span></span