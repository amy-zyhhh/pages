\"><span style=\"color:#000000\"><font face=\"宋体\">选择绕行线路。给师生员工工作、学习造成不便，深表歉意，感谢大家理解配合！</font></span></span></span></span></span></span></span></span></p> \n <p style=\"margin-left:37px; text-indent:-28.0000pt\"><span style=\"font-size:12pt\"><span style=\"line-height:150%\"><span style=\"font-family:宋体\">  <span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">街道办</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">联系人：周</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">老师</font></span></span></span>  <span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">电话（手机）：</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\">13366226288</span></span></span></span></span></span></p> \n <p style=\"margin-left:37px; text-indent:-28.0000pt\"><span style=\"font-size:12pt\"><span style=\"line-height:150%\"><span style=\"font-family:宋体\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">  现场负责人：耿</font></span></span></span><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">工</font></span></span></span>  <span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font face=\"宋体\">电话（手机）：</font><font face=\"宋体\">15726665660</font></span></span></span></span></span></span></p> \n <p style=\"margin-left:37px; text-indent:-28.0000pt\"><span style=\"font-size:12pt\"><span style=\"line-height:150%\"><span style=\"font-family:宋体\"><span style=\"font-size:14.0000pt\"><span style=\"font-family:宋体\"><span style=\"line-height:150%\"><font f