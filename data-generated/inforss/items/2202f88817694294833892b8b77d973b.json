  "title": "【转发】欢迎报名参加“清华大学私募基金综合能力提升项目”",
  "date": "20260821",
  "time": "2026-08-21 16:48",
  "category": "教务通知",
  "department": "研究生院",
  "sourceId": "tsinghua-info-all",
  "sourceName": "清华信息门户",
  "source": "清华信息门户",
